{% extends 'base.html.twig' %}

{% block title %}Tarifs KIBARE-JOB{% endblock %}

{% block body %}
<main class="min-h-screen bg-slate-50 text-slate-950">
    <section class="mx-auto max-w-6xl px-4 py-12">
        <div class="mb-8">
            <p class="text-sm font-semibold uppercase tracking-wide text-teal-700">Abonnements employeurs</p>
            <h1 class="mt-2 text-3xl font-bold">Choisissez le plan adapte a votre recrutement</h1>
            <p class="mt-3 max-w-2xl text-slate-600">
                En phase 1, KIBARE-JOB fonctionne en mode gratuit mock. Les tarifs ci-dessous preparent le passage au freemium.
            </p>
        </div>

        <div class="grid gap-5 md:grid-cols-3">
            {% set plans = [
                {
                    name: 'Gratuit',
                    price: '0 FCFA',
                    description: 'Pour tester la publication d offres.',
                    features: ['1 offre active', '10 candidatures par offre', 'Statistiques basiques']
                },
                {
                    name: 'Standard',
                    price: '20 000 FCFA / mois',
                    description: 'Pour les PME qui recrutent regulierement.',
                    features: ['5 offres actives', '100 candidatures par offre', 'Export CSV', 'Statistiques avancees']
                },
                {
                    name: 'Pro',
                    price: '75 000 FCFA / mois',
                    description: 'Pour les equipes RH et cabinets.',
                    features: ['Offres illimitees', 'Candidatures illimitees', 'API access', 'Support prioritaire', 'Marque blanche optionnelle']
                }
            ] %}

            {% for plan in plans %}
                <article class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
                    <h2 class="text-xl font-semibold">{{ plan.name }}</h2>
                    <p class="mt-2 text-2xl font-bold text-teal-700">{{ plan.price }}</p>
                    <p class="mt-3 text-sm text-slate-600">{{ plan.description }}</p>
                    <ul class="mt-5 space-y-2 text-sm">
                        {% for feature in plan.features %}
                            <li class="flex gap-2">
                                <span class="text-teal-700">✓</span>
                                <span>{{ feature }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                    <form class="mt-6" method="post" action="/api/subscription/subscribe">
                        <input type="hidden" name="planCode" value="employer_{{ plan.name|lower }}">
                        <input type="hidden" name="method" value="none">
                        <button class="w-full rounded-md bg-teal-700 px-4 py-2 font-semibold text-white" type="submit">
                            Choisir {{ plan.name }}
                        </button>
                    </form>
                </article>
            {% endfor %}
        </div>

        <section class="mt-10 rounded-lg border border-slate-200 bg-white p-6">
            <h2 class="text-xl font-semibold">Paiements prevus</h2>
            <p class="mt-2 text-slate-600">
                Les paiements Orange Money et Moov Money seront actives en production. Pour les tests actuels, le mode mock valide automatiquement l abonnement.
            </p>
        </section>
    </section>
</main>
{% endblock %}
