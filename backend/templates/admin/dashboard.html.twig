{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}KIBARE-JOB Admin{% endblock %}

{% block main %}
    <section class="content-panel">
        <div class="content-panel-body">
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;">
                <article class="card">
                    <div class="card-body">
                        <strong>{{ stats.users }}</strong>
                        <div>Utilisateurs</div>
                    </div>
                </article>
                <article class="card">
                    <div class="card-body">
                        <strong>{{ stats.employersToValidate }}</strong>
                        <div>Employeurs a valider</div>
                    </div>
                </article>
                <article class="card">
                    <div class="card-body">
                        <strong>{{ stats.activeOffers }}</strong>
                        <div>Offres actives</div>
                    </div>
                </article>
                <article class="card">
                    <div class="card-body">
                        <strong>{{ stats.documentsToModerate }}</strong>
                        <div>Documents a moderer</div>
                    </div>
                </article>
                <article class="card">
                    <div class="card-body">
                        <strong>{{ stats.pendingReports }}</strong>
                        <div>Signalements</div>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section class="content-panel">
        <div class="content-panel-header">
            <h2 class="title">Dernieres inscriptions</h2>
        </div>
        <div class="content-panel-body">
            <table class="table datagrid">
                <thead>
                    <tr><th>Email</th><th>Téléphone</th><th>Roles</th><th>Date</th></tr>
                </thead>
                <tbody>
                    {% for user in latestUsers %}
                        <tr>
                            <td>{{ user.email }}</td>
                            <td>{{ user.phone }}</td>
                            <td>{{ user.roles|join(', ') }}</td>
                            <td>{{ user.createdAt|date('d/m/Y H:i') }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4">Aucune inscription.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="content-panel">
        <div class="content-panel-header">
            <h2 class="title">Offres actives recentes</h2>
        </div>
        <div class="content-panel-body">
            <table class="table datagrid">
                <thead>
                    <tr><th>Titre</th><th>Lieu</th><th>Candidatures</th><th>Deadline</th></tr>
                </thead>
                <tbody>
                    {% for offer in activeOffers %}
                        <tr>
                            <td>{{ offer.title }}</td>
                            <td>{{ offer.location }}</td>
                            <td>{{ offer.applicationsCount }}</td>
                            <td>{{ offer.deadline|date('d/m/Y') }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4">Aucune offre active.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="content-panel">
        <div class="content-panel-header">
            <h2 class="title">Documents a moderer</h2>
        </div>
        <div class="content-panel-body">
            <table class="table datagrid">
                <thead>
                    <tr><th>Titre</th><th>Type</th><th>Score</th><th>Upload</th></tr>
                </thead>
                <tbody>
                    {% for document in flaggedDocuments %}
                        <tr>
                            <td>{{ document.title }}</td>
                            <td>{{ document.type.value }}</td>
                            <td>{{ document.confidenceScore }}</td>
                            <td>{{ document.uploadedAt|date('d/m/Y H:i') }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4">Aucun document a moderer.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}



