{% extends 'base.html.twig' %}

{% block title %}Accès non autorisé - KIBARE-JOB{% endblock %}

{% block body %}
<main class="error-page-shell min-h-screen bg-gradient-to-br from-slate-50 via-white to-stone-50 px-4 pb-10 text-slate-900">
    <div class="error-page-wrap mx-auto flex max-w-5xl items-start justify-center">
        <section class="w-full overflow-hidden rounded-[2rem] bg-white shadow-2xl shadow-slate-200/70 ring-1 ring-slate-100">
            <div class="grid gap-0 lg:grid-cols-[0.95fr_1.05fr]">
                <div class="bg-gradient-to-br from-primary to-secondary p-8 text-white lg:p-10">
                    <a href="{{ path('home') }}" class="mb-10 inline-flex items-center gap-3">
                        <img src="{{ asset('assets/brand/kibare-job-logo.jpg') }}" alt="KIBARE-JOB" class="h-14 w-auto rounded-2xl shadow-lg shadow-black/20">
                    </a>
                    <p class="inline-flex rounded-full bg-white/15 px-4 py-2 text-sm font-black ring-1 ring-white/20">Erreur 403</p>
                    <h1 class="mt-5 text-4xl font-black leading-tight md:text-5xl">Accès réservé</h1>
                    <p class="mt-5 max-w-md text-base font-semibold leading-7 text-white/85">
                        Cette zone est protégée afin de préserver les données sensibles de la plateforme.
                    </p>
                </div>

                <div class="p-8 lg:p-10">
                    <div class="mb-6 grid h-16 w-16 place-items-center rounded-3xl bg-secondary/10 text-primary">
                        <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.4 8.4 8 9 4.6-.6 8-4 8-9V6l-8-3Z" stroke="currentColor" stroke-width="2"/><path d="M12 8v5M12 16h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    </div>
                    <h2 class="text-2xl font-black text-slate-950">Vous n’avez pas les droits requis.</h2>
                    <p class="mt-4 leading-7 text-slate-600">
                        Votre compte est connecté, mais il ne possède pas le rôle nécessaire pour accéder à cette page. L’espace d’administration est réservé aux administrateurs KIBARE-JOB.
                    </p>
                    <div class="mt-5 rounded-2xl bg-slate-50 p-4 text-sm font-semibold text-slate-500">
                        Page demandée : <span class="font-black text-slate-700">{{ requestedPath }}</span>
                    </div>

                    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                        <a href="{{ recruiterUrl }}" class="inline-flex items-center justify-center rounded-2xl bg-gradient-to-r from-secondary to-primary px-6 py-3 font-black text-white shadow-lg shadow-secondary/20 transition hover:-translate-y-0.5">
                            Retour à mon espace
                        </a>
                        <a href="{{ homeUrl }}" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-6 py-3 font-black text-slate-700 transition hover:border-primary/20 hover:text-primary">
                            Accueil
                        </a>
                    </div>
                    <p class="mt-6 text-sm font-semibold text-slate-500">
                        Si vous pensez que c’est une erreur, contactez un administrateur ou reconnectez-vous avec un compte autorisé.
                    </p>
                    <a href="{{ logoutUrl }}" class="mt-3 inline-flex text-sm font-black text-primary transition hover:text-secondary">Se connecter avec un autre compte</a>
                </div>
            </div>
        </section>
    </div>
</main>
{% endblock %}
