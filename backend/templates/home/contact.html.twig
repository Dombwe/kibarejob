{% extends 'base.html.twig' %}

{% block title %}Contact - KIBARE-JOB{% endblock %}

{% block body %}
<main class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-stone-50 text-slate-900 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900 dark:text-slate-100">
    <header class="border-b border-slate-200/80 bg-white/85 px-4 py-5 backdrop-blur dark:border-slate-800 dark:bg-slate-950/85 md:px-8">
        <div class="mx-auto flex max-w-7xl items-center justify-between">
            <a href="{{ path('home') }}" class="flex items-center gap-3">
                <span class="grid h-10 w-10 place-items-center rounded-2xl bg-gradient-to-br from-secondary to-primary text-white shadow-lg shadow-secondary/20">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M10 6h4a2 2 0 0 1 2 2v1h3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3V8a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        <path d="M8 9h8M10 6V5h4v1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                </span>
                <span class="text-xl font-black text-primary dark:text-white">KIBARE-JOB</span>
            </a>
            <nav class="hidden items-center gap-6 text-sm font-semibold text-slate-600 dark:text-slate-300 md:flex">
                <a href="{{ path('home') }}#features" class="transition hover:text-secondary">Fonctionnalités</a>
                <a href="{{ path('home') }}#stats" class="transition hover:text-secondary">Statistiques</a>
                <a href="{{ path('candidate_landing') }}" class="transition hover:text-secondary">Candidats</a>
                <a href="{{ path('recruiter_entry') }}" class="rounded-full bg-primary px-5 py-2.5 font-black text-white shadow-sm transition hover:bg-secondary">Espace recruteur</a>
            </nav>
        </div>
    </header>

    <section class="px-4 py-14 md:px-8 md:py-20">
        <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[.85fr_1.15fr] lg:items-start">
            <div class="fade-in">
                <p class="inline-flex rounded-full border border-secondary/15 bg-white px-4 py-2 text-sm font-black text-secondary shadow-sm dark:border-secondary/25 dark:bg-slate-900">
                    Contact
                </p>
                <h1 class="mt-6 max-w-xl text-4xl font-black leading-tight text-slate-950 dark:text-white md:text-6xl">
                    Parlons de votre besoin.
                </h1>
                <p class="mt-6 max-w-xl text-lg leading-8 text-slate-600 dark:text-slate-300">
                    Une question sur KIBARE-JOB, un partenariat, un besoin recruteur ou une suggestion ? Envoyez-nous un message clair, notre équipe vous repondra rapidement.
                </p>

                <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
                    <article class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
                        <div class="flex gap-4">
                            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-secondary/15 text-primary">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6h16v12H4V6Z" stroke="currentColor" stroke-width="2"/><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                            </span>
                            <div>
                                <h2 class="font-black text-slate-950 dark:text-white">Email</h2>
                                <p class="mt-1 text-sm font-semibold text-slate-500 dark:text-slate-400">contact@kibarejob.test</p>
                            </div>
                        </div>
                    </article>
                    <article class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
                        <div class="flex gap-4">
                            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-secondary/15 text-primary">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s7-4.5 7-11a7 7 0 1 0-14 0c0 6.5 7 11 7 11Z" stroke="currentColor" stroke-width="2"/><path d="M12 11.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" stroke="currentColor" stroke-width="2"/></svg>
                            </span>
                            <div>
                                <h2 class="font-black text-slate-950 dark:text-white">Localisation</h2>
                                <p class="mt-1 text-sm font-semibold text-slate-500 dark:text-slate-400">Ouagadougou, Burkina Faso</p>
                            </div>
                        </div>
                    </article>
                </div>
            </div>

            <div class="fade-in rounded-[2rem] border border-slate-200 bg-white p-5 shadow-2xl shadow-slate-200/70 dark:border-slate-800 dark:bg-slate-900 dark:shadow-black/30 md:p-8">
                {% for message in app.flashes('success') %}
                    <div class="mb-6 rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm font-bold text-emerald-800 dark:border-emerald-900/60 dark:bg-emerald-950/40 dark:text-emerald-200">
                        {{ message }}
                    </div>
                {% endfor %}
                {% if errors|default([]) is not empty %}
                    <div class="mb-6 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm font-bold text-red-800 dark:border-red-900/60 dark:bg-red-950/40 dark:text-red-200">
                        <p>Merci de corriger les points suivants :</p>
                        <ul class="mt-2 list-inside list-disc space-y-1">
                            {% for error in errors %}
                                <li>{{ error }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                <form method="post" action="{{ path('contact') }}" class="space-y-5">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('contact_form') }}">
                    <input type="text" name="website" value="" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true">

                    <div class="grid gap-5 md:grid-cols-2">
                        <label class="block">
                            <span class="text-sm font-black text-slate-700 dark:text-slate-200">Nom complet</span>
                            <input type="text" name="full_name" required placeholder="Votre nom" value="{{ formData.full_name|default('') }}"
                                class="mt-2 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-secondary focus:bg-white focus:ring-4 focus:ring-secondary/10 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:bg-slate-950">
                        </label>
                        <label class="block">
                            <span class="text-sm font-black text-slate-700 dark:text-slate-200">Email</span>
                            <input type="email" name="email" required placeholder="vous@exemple.com" value="{{ formData.email|default('') }}"
                                class="mt-2 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-secondary focus:bg-white focus:ring-4 focus:ring-secondary/10 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:bg-slate-950">
                        </label>
                    </div>

                    <div class="grid gap-5 md:grid-cols-2">
                        <label class="block">
                            <span class="text-sm font-black text-slate-700 dark:text-slate-200">Profil</span>
                            <select name="profile"
                                class="mt-2 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold text-slate-900 outline-none transition focus:border-secondary focus:bg-white focus:ring-4 focus:ring-secondary/10 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:bg-slate-950">
                                <option value="candidate" {{ formData.profile|default('candidate') == 'candidate' ? 'selected' : '' }}>Candidat</option>
                                <option value="employer" {{ formData.profile|default('candidate') == 'employer' ? 'selected' : '' }}>Recruteur</option>
                                <option value="partner" {{ formData.profile|default('candidate') == 'partner' ? 'selected' : '' }}>Partenaire</option>
                                <option value="other" {{ formData.profile|default('candidate') == 'other' ? 'selected' : '' }}>Autre</option>
                            </select>
                        </label>
                        <label class="block">
                            <span class="text-sm font-black text-slate-700 dark:text-slate-200">Téléphone</span>
                            <input type="tel" name="phone" placeholder="+226 ..." value="{{ formData.phone|default('') }}"
                                class="mt-2 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-secondary focus:bg-white focus:ring-4 focus:ring-secondary/10 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:bg-slate-950">
                        </label>
                    </div>

                    <label class="block">
                        <span class="text-sm font-black text-slate-700 dark:text-slate-200">Objet</span>
                        <input type="text" name="subject" required placeholder="Ex: Demande de partenariat" value="{{ formData.subject|default('') }}"
                            class="mt-2 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-secondary focus:bg-white focus:ring-4 focus:ring-secondary/10 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:bg-slate-950">
                    </label>

                    <label class="block">
                        <span class="text-sm font-black text-slate-700 dark:text-slate-200">Message</span>
                        <textarea name="message" required rows="6" placeholder="Expliquez-nous votre besoin..."
                            class="mt-2 w-full resize-none rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-secondary focus:bg-white focus:ring-4 focus:ring-secondary/10 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:bg-slate-950">{{ formData.message|default('') }}</textarea>
                    </label>

                    <button type="submit" class="inline-flex w-full items-center justify-center gap-3 rounded-2xl bg-gradient-to-r from-secondary to-primary px-6 py-4 font-black text-white shadow-lg shadow-secondary/20 transition hover:-translate-y-0.5 hover:shadow-xl hover:shadow-secondary/25">
                        Envoyer le message
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    </button>
                </form>
            </div>
        </div>
    </section>
</main>
{% endblock %}



