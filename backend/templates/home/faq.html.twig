{% extends 'base.html.twig' %}

{% block title %}FAQ - KIBARE-JOB{% endblock %}

{% block body %}
{% set faqs = [
    {
        category: 'Candidats',
        items: [
            {question: 'KIBARE-JOB est-il gratuit pour les candidats ?', answer: 'Oui. Pendant la phase de lancement, l application candidat est gratuite afin de faciliter l acces aux offres et aux candidatures.'},
            {question: 'Comment les candidats postulent-ils aux offres ?', answer: 'Les candidats utilisent l application mobile. Ils completent leur profil, ajoutent leurs documents, puis peuvent aimer une offre pour envoyer une candidature preparee.'},
            {question: 'Puis-je utiliser KIBARE-JOB si je n ai pas encore de CV ?', answer: 'Oui. L application aide les candidats a construire un profil exploitable et a valoriser leurs competences, experiences et documents.'}
        ]
    },
    {
        category: 'Recruteurs',
        items: [
            {question: 'A quoi sert l espace recruteur ?', answer: 'L espace recruteur permet de publier des offres, suivre les candidatures, consulter les scores de matching et organiser le traitement des profils.'},
            {question: 'Comment sont classes les candidats ?', answer: 'KIBARE-JOB analyse les competences, la localisation, le niveau d etude, l experience et les documents afin de proposer un score de compatibilite.'},
            {question: 'Puis-je demander des documents precis dans une offre ?', answer: 'Oui. Lors de la publication d une offre, vous pouvez definir les documents requis ou optionnels comme le CV, la lettre, les diplomes, certificats ou attestations.'}
        ]
    },
    {
        category: 'Plateforme',
        items: [
            {question: 'KIBARE-JOB fonctionne-t-il avec une connexion faible ?', answer: 'La plateforme est pensee pour le contexte local, avec une experience mobile rapide et un objectif de consommation de donnees reduite.'},
            {question: 'Les emails de confirmation sont-ils obligatoires ?', answer: 'Oui. Pour securiser les comptes recruteurs, l adresse email doit etre confirmee avant la connexion.'},
            {question: 'Comment contacter l equipe KIBARE-JOB ?', answer: 'Vous pouvez utiliser la page Contact pour envoyer une demande, une question, une proposition de partenariat ou un retour produit.'}
        ]
    }
] %}

<main class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-stone-50 text-slate-900 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900 dark:text-slate-100">
    <header class="border-b border-slate-200/80 bg-white/85 px-4 py-5 backdrop-blur dark:border-slate-800 dark:bg-slate-950/85 md:px-8">
        <div class="mx-auto flex max-w-7xl items-center justify-between">
            <a href="{{ path('home') }}" class="flex items-center gap-3">
                <span class="grid h-10 w-10 place-items-center rounded-2xl bg-gradient-to-br from-secondary to-primary text-white shadow-lg shadow-secondary/20">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M10 6h4a2 2 0 0 1 2 2v1h3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3V8a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        <path d="M8 9h8M10 6V5h4v1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                </span>
                <span class="text-xl font-black text-primary dark:text-white">KIBARE-JOB</span>
            </a>
            <nav class="hidden items-center gap-6 text-sm font-semibold text-slate-600 dark:text-slate-300 md:flex">
                <a href="{{ path('home') }}" class="transition hover:text-secondary">Accueil</a>
                <a href="{{ path('candidate_landing') }}" class="transition hover:text-secondary">Candidats</a>
                <a href="{{ path('contact') }}" class="transition hover:text-secondary">Contact</a>
                <a href="{{ path('recruiter_entry') }}" class="rounded-full bg-primary px-5 py-2.5 font-black text-white shadow-sm transition hover:bg-secondary">Espace recruteur</a>
            </nav>
        </div>
    </header>

    <section class="px-4 py-14 md:px-8 md:py-20">
        <div class="mx-auto max-w-7xl">
            <div class="fade-in mx-auto max-w-3xl text-center">
                <p class="inline-flex rounded-full border border-secondary/15 bg-white px-4 py-2 text-sm font-black text-secondary shadow-sm dark:border-secondary/25 dark:bg-slate-900">
                    Foire aux questions
                </p>
                <h1 class="mt-6 text-4xl font-black leading-tight text-slate-950 dark:text-white md:text-6xl">
                    Tout comprendre sur KIBARE-JOB.
                </h1>
                <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">
                    Retrouvez les reponses essentielles pour les candidats, les recruteurs et les partenaires qui souhaitent utiliser la plateforme.
                </p>
            </div>

            <div class="mt-14 grid gap-6 lg:grid-cols-3">
                {% for group in faqs %}
                    <section class="fade-in rounded-[2rem] border border-slate-200 bg-white p-6 shadow-xl shadow-slate-200/60 dark:border-slate-800 dark:bg-slate-900 dark:shadow-black/25">
                        <h2 class="text-xl font-black text-slate-950 dark:text-white">{{ group.category }}</h2>
                        <div class="mt-6 space-y-3">
                            {% for item in group.items %}
                                <details class="group rounded-2xl bg-slate-50 p-4 ring-1 ring-slate-100 transition open:bg-secondary/5 dark:bg-slate-950 dark:ring-slate-800 dark:open:bg-slate-800">
                                    <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-black text-slate-800 dark:text-slate-100">
                                        <span>{{ item.question }}</span>
                                        <span class="mt-1 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-white text-primary ring-1 ring-slate-200 transition group-open:rotate-45 dark:bg-slate-900 dark:ring-slate-700">
                                            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                                        </span>
                                    </summary>
                                    <p class="mt-4 leading-7 text-slate-600 dark:text-slate-300">{{ item.answer }}</p>
                                </details>
                            {% endfor %}
                        </div>
                    </section>
                {% endfor %}
            </div>

            <div class="fade-in mt-12 rounded-[2rem] bg-slate-950 p-8 text-center text-white shadow-2xl shadow-slate-300/70 dark:shadow-black/40">
                <h2 class="text-2xl font-black">Vous ne trouvez pas votre reponse ?</h2>
                <p class="mx-auto mt-3 max-w-2xl leading-7 text-white/70">
                    Envoyez-nous votre question et nous vous repondrons rapidement avec les informations utiles.
                </p>
                <a href="{{ path('contact') }}" class="mt-6 inline-flex items-center justify-center rounded-full bg-gradient-to-r from-secondary to-primary px-7 py-4 font-black text-white shadow-lg shadow-secondary/20 transition hover:-translate-y-0.5">
                    Contacter l equipe
                </a>
            </div>
        </div>
    </section>
</main>
{% endblock %}
