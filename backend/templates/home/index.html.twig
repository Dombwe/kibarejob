{% extends 'base.html.twig' %}

{% block title %}KIBARE-JOB - Trouvez l'emploi parfait au Burkina Faso{% endblock %}

{% block body %}
{% set features = [
    {
        title: 'Swipe intelligent',
        description: 'Decouvrez les offres comme sur Tinder, avec une experience rapide et mobile.',
        icon: 'zap'
    },
    {
        title: 'CV genere par IA',
        description: 'Sans CV ? KIBARE-JOB vous aide a construire un profil professionnel.',
        icon: 'shield'
    },
    {
        title: 'Matching precis',
        description: 'Les offres sont classees selon vos competences, documents et disponibilite.',
        icon: 'trend'
    },
    {
        title: 'Concu pour la BF',
        description: 'Une plateforme adaptee au contexte local et aux connexions mobiles.',
        icon: 'globe'
    }
] %}

{% set stats = homeStats|default([
    { value: '10K+', label: 'Candidats' },
    { value: '500+', label: 'Entreprises' },
    { value: '2K+', label: 'Recrutements' },
    { value: '95%', label: 'Satisfaction' }
]) %}

<main class="min-h-screen overflow-hidden bg-gradient-to-br from-slate-50 via-white to-stone-50 text-slate-900">
    <header class="px-4 py-6 md:px-8">
        <div class="mx-auto flex max-w-7xl items-center justify-between">
            <a href="{{ path('home') }}" class="flex items-center gap-3">
                <span class="grid h-10 w-10 place-items-center rounded-2xl bg-gradient-to-br from-secondary to-primary text-white shadow-lg shadow-secondary/20">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M10 6h4a2 2 0 0 1 2 2v1h3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3V8a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        <path d="M8 9h8M10 6V5h4v1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                </span>
                <span class="text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary">KIBARE-JOB</span>
            </a>

            <nav class="hidden items-center gap-7 text-sm font-semibold text-slate-600 md:flex">
                <a href="#features" class="transition hover:text-secondary">Fonctionnalites</a>
                <a href="#stats" class="transition hover:text-secondary">Statistiques</a>
                <a href="{{ path('faq') }}" class="transition hover:text-secondary">FAQ</a>
                <a href="{{ path('contact') }}" class="transition hover:text-secondary">Contact</a>
                {% if app.user %}
                    <a href="{{ path('recruiter_entry') }}" class="rounded-full border border-slate-200 bg-white px-5 py-2.5 text-slate-700 shadow-sm transition hover:border-secondary/30 hover:text-secondary hover:shadow-md">Mon espace</a>
                    <a href="{{ path('app_logout') }}" class="rounded-full bg-primary px-5 py-2.5 text-white shadow-sm transition hover:bg-secondary hover:shadow-md">Deconnexion</a>
                {% else %}
                    <a href="{{ path('app_register') }}" class="rounded-full border border-slate-200 bg-white px-5 py-2.5 text-slate-700 shadow-sm transition hover:border-secondary/30 hover:text-secondary hover:shadow-md">Creer un compte</a>
                    <a href="{{ path('app_login') }}" class="rounded-full bg-primary px-5 py-2.5 text-white shadow-sm transition hover:bg-secondary hover:shadow-md">Connexion</a>
                {% endif %}
            </nav>
        </div>
    </header>

    <section class="px-4 pb-16 pt-12 md:pb-20 md:pt-20">
        <div class="mx-auto max-w-7xl">
            <div class="fade-in mx-auto mb-14 max-w-3xl text-center">
                <p class="mb-5 inline-flex rounded-full border border-secondary/15 bg-white px-4 py-2 text-sm font-bold text-secondary shadow-sm">Recrutement intelligent pour le Burkina Faso</p>
                <h1 class="text-4xl font-black leading-tight text-slate-950 md:text-6xl">
                    Trouvez l'emploi parfait au
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary">Burkina Faso</span>
                </h1>
                <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-slate-600 md:text-xl">
                    La plateforme de recrutement qui fonctionne comme Tinder. Swipez, postulez, recrutez et avancez plus vite.
                </p>
                <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
                    <a href="{{ path('candidate_landing') }}" class="inline-flex items-center justify-center gap-3 rounded-full bg-gradient-to-r from-secondary to-primary px-8 py-4 font-black text-white shadow-lg shadow-secondary/20 transition hover:-translate-y-0.5 hover:shadow-xl hover:shadow-secondary/25">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 2h8a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2"/><path d="M11 18h2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                        Application candidat
                    </a>
                    <a href="{{ path('recruiter_entry') }}" class="inline-flex items-center justify-center gap-3 rounded-full border-2 border-slate-200 bg-white px-8 py-4 font-black text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:border-secondary/30 hover:text-secondary hover:shadow-lg">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5h16v11H4V5Z" stroke="currentColor" stroke-width="2"/><path d="M9 20h6M12 16v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                        Espace recruteur
                    </a>
                </div>
            </div>

            <div class="fade-in mx-auto grid max-w-4xl gap-8 md:grid-cols-2">
                <a href="{{ path('candidate_landing') }}" class="group block">
                    <article class="relative h-full overflow-hidden rounded-3xl border border-secondary/10 bg-white p-8 shadow-xl shadow-slate-200/70 transition hover:-translate-y-1 hover:shadow-2xl">
                        <div class="absolute right-0 top-0 h-32 w-32 translate-x-1/3 -translate-y-1/3 rounded-full bg-gradient-to-br from-secondary/10 to-accent/25 opacity-80"></div>
                        <div class="relative">
                            <div class="mb-6 grid h-16 w-16 place-items-center rounded-2xl bg-gradient-to-br from-secondary to-primary text-white shadow-lg shadow-secondary/20">
                                <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 2h8a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2"/><path d="M11 18h2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                            </div>
                            <h2 class="text-2xl font-black text-slate-950">Application Mobile</h2>
                            <p class="mt-3 leading-7 text-slate-600">Pour les candidats. Swipez les offres, laissez l'IA creer votre CV et postuler automatiquement.</p>
                            <ul class="mt-6 space-y-3 text-sm font-semibold text-slate-500">
                                <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 rounded-full bg-secondary"></span>Swipez les offres d'emploi</li>
                                <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 rounded-full bg-secondary"></span>CV genere automatiquement</li>
                                <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 rounded-full bg-secondary"></span>Matching intelligent</li>
                                <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 rounded-full bg-secondary"></span>Mode hors-ligne</li>
                            </ul>
                        </div>
                    </article>
                </a>

                <a href="{{ path('recruiter_entry') }}" class="group block">
                    <article class="relative h-full overflow-hidden rounded-3xl border border-slate-100 bg-white p-8 shadow-xl shadow-slate-200/70 transition hover:-translate-y-1 hover:shadow-2xl">
                        <div class="absolute right-0 top-0 h-32 w-32 translate-x-1/3 -translate-y-1/3 rounded-full bg-gradient-to-br from-slate-100 to-secondary/10 opacity-80"></div>
                        <div class="relative">
                            <div class="mb-6 grid h-16 w-16 place-items-center rounded-2xl bg-gradient-to-br from-primary to-secondary text-white shadow-lg shadow-secondary/20">
                                <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5h16v11H4V5Z" stroke="currentColor" stroke-width="2"/><path d="M9 20h6M12 16v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                            </div>
                            <h2 class="text-2xl font-black text-slate-950">Dashboard Recruteur</h2>
                            <p class="mt-3 leading-7 text-slate-600">Pour les entreprises. Publiez des offres, recevez des candidatures qualifiees et recrutez plus vite.</p>
                            <ul class="mt-6 space-y-3 text-sm font-semibold text-slate-500">
                                <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 rounded-full bg-primary"></span>Publication d'offres simple</li>
                                <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 rounded-full bg-primary"></span>Candidatures scorees par IA</li>
                                <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 rounded-full bg-primary"></span>Statistiques RH completes</li>
                                <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 rounded-full bg-primary"></span>Email integre</li>
                            </ul>
                        </div>
                    </article>
                </a>
            </div>
        </div>
    </section>

    <section id="features" class="bg-white px-4 py-16">
        <div class="mx-auto max-w-7xl">
            <div class="fade-in mx-auto mb-12 max-w-2xl text-center">
                <h2 class="text-3xl font-black text-slate-950 md:text-4xl">Pourquoi choisir KIBARE-JOB ?</h2>
                <p class="mt-4 leading-7 text-slate-600">Une plateforme concue pour le contexte burkinabe, avec des fonctionnalites adaptees a la realite locale.</p>
            </div>

            <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
                {% for feature in features %}
                    <article class="fade-in rounded-2xl bg-slate-50 p-6 transition hover:-translate-y-1 hover:bg-secondary/5 hover:shadow-soft">
                        <div class="mb-4 grid h-12 w-12 place-items-center rounded-xl bg-gradient-to-br from-secondary to-primary text-white shadow-lg shadow-secondary/20">
                            {% if feature.icon == 'zap' %}
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m13 2-9 13h7l-1 7 9-13h-7l1-7Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
                            {% elseif feature.icon == 'shield' %}
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
                            {% elseif feature.icon == 'trend' %}
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m3 17 6-6 4 4 7-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M14 7h6v6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                            {% else %}
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z" stroke="currentColor" stroke-width="2"/><path d="M2 12h20M12 2c3 3 4 6 4 10s-1 7-4 10c-3-3-4-6-4-10s1-7 4-10Z" stroke="currentColor" stroke-width="2"/></svg>
                            {% endif %}
                        </div>
                        <h3 class="text-lg font-black text-slate-950">{{ feature.title }}</h3>
                        <p class="mt-2 leading-6 text-slate-600">{{ feature.description }}</p>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>

    <section id="stats" class="bg-gradient-to-r from-primary to-secondary px-4 py-16">
        <div class="mx-auto max-w-7xl">
            <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
                {% for stat in stats %}
                    <div class="fade-in text-center text-white">
                        <div class="text-4xl font-black md:text-5xl">{{ stat.value }}</div>
                        <div class="mt-2 font-semibold text-slate-100">{{ stat.label }}</div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section id="contact" class="px-4 py-16">
        <div class="fade-in mx-auto max-w-4xl text-center">
            <h2 class="text-3xl font-black text-slate-950 md:text-4xl">Pret a trouver votre prochain talent ou emploi ?</h2>
            <p class="mx-auto mt-5 max-w-2xl leading-7 text-slate-600">Rejoignez les candidats et recruteurs qui veulent une experience plus simple, plus rapide et mieux adaptee au marche local.</p>
            <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
                <a href="{{ path('candidate_landing') }}" class="inline-flex items-center justify-center gap-3 rounded-full bg-secondary px-6 py-3 font-black text-white shadow-lg shadow-secondary/20 transition hover:bg-primary">Je cherche un emploi</a>
                <a href="{{ path('recruiter_entry') }}" class="inline-flex items-center justify-center gap-3 rounded-full bg-primary px-6 py-3 font-black text-white shadow-lg shadow-primary/20 transition hover:bg-secondary">Je recrute</a>
            </div>
        </div>
    </section>

    <footer class="border-t border-slate-200 bg-white/70 px-4 py-8">
        <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 text-sm text-slate-500 md:flex-row">
            <a href="{{ path('home') }}" class="flex items-center gap-2 font-black text-slate-900">
                <span class="grid h-8 w-8 place-items-center rounded-xl bg-gradient-to-br from-secondary to-primary text-white">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M10 6h4a2 2 0 0 1 2 2v1h3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3V8a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                </span>
                KIBARE-JOB
            </a>
            <p>Concu avec soin au Burkina Faso</p>
            <div class="flex gap-5">
                <a href="#" class="transition hover:text-secondary">CGU</a>
                <a href="#" class="transition hover:text-secondary">Confidentialite</a>
                <a href="{{ path('contact') }}" class="transition hover:text-secondary">Contact</a>
            </div>
        </div>
    </footer>
</main>
{% endblock %}
