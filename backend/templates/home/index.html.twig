{% extends 'base.html.twig' %}

{% block title %}KIBARE-JOB - Le recrutement intelligent pour l'Afrique{% endblock %}

{% block body %}
<main class="overflow-hidden">
    <section class="relative min-h-[92vh] bg-[radial-gradient(circle_at_top_left,#22C55E_0,#22C55E_18%,transparent_38%),linear-gradient(135deg,#0F172A_0%,#10213f_48%,#0F172A_100%)] text-white">
        <nav class="mx-auto flex max-w-7xl items-center justify-between px-5 py-6">
            <a href="{{ path('home') }}" class="flex items-center gap-3 font-black tracking-wide">
                <span class="grid h-11 w-11 place-items-center rounded-2xl bg-white text-primary shadow-soft">KJ</span>
                <span>KIBARE-JOB</span>
            </a>
            <div class="hidden items-center gap-7 text-sm font-semibold text-white/80 md:flex">
                <a class="transition hover:text-white" href="#features">Fonctionnalites</a>
                <a class="transition hover:text-white" href="#how">Comment ca marche</a>
                <a class="transition hover:text-white" href="{{ path('candidate_landing') }}">Candidats</a>
                <a class="rounded-full bg-white px-5 py-2.5 text-primary transition hover:scale-105" href="{{ path('app_login') }}">Connexion</a>
            </div>
        </nav>

        <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 pb-24 pt-16 lg:grid-cols-[1.08fr_.92fr] lg:pt-20">
            <div class="fade-in">
                <p class="mb-5 inline-flex rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold text-emerald-100 backdrop-blur">Recrutement mobile-first pour l'Afrique</p>
                <h1 class="max-w-4xl text-6xl font-black leading-[0.95] tracking-normal sm:text-7xl lg:text-8xl">KIBARE-JOB</h1>
                <p class="mt-7 max-w-2xl text-2xl font-semibold text-white/90 sm:text-3xl">Le recrutement intelligent pour l'Afrique</p>
                <p class="mt-6 max-w-2xl text-lg leading-8 text-white/72">Des candidatures mieux preparees, des offres plus pertinentes, et un matching local concu pour les connexions 3G et les talents du Burkina Faso.</p>
                <div class="mt-10 flex flex-col gap-4 sm:flex-row">
                    <a href="{{ path('candidate_landing') }}" class="group inline-flex items-center justify-center rounded-2xl bg-accent px-8 py-4 text-base font-black text-primary shadow-soft transition duration-300 hover:scale-105">
                        Candidat
                        <span class="ml-3 transition group-hover:translate-x-1">→</span>
                    </a>
                    <a href="{{ path('recruiter_entry') }}" class="inline-flex items-center justify-center rounded-2xl border border-white/25 bg-white/10 px-8 py-4 text-base font-black text-white backdrop-blur transition duration-300 hover:scale-105 hover:bg-white/16">Recruteur</a>
                </div>
            </div>

            <div class="fade-in relative mx-auto w-full max-w-md">
                <div class="absolute -inset-6 rounded-[2rem] bg-white/10 blur-2xl"></div>
                <div class="relative rounded-[2rem] border border-white/16 bg-white/12 p-5 shadow-soft backdrop-blur-xl">
                    <div class="rounded-[1.5rem] bg-slate-950 p-4">
                        <div class="mb-4 flex items-center justify-between">
                            <div>
                                <p class="text-xs text-slate-400">Match score</p>
                                <p class="text-3xl font-black text-accent">92%</p>
                            </div>
                            <span class="rounded-full bg-accent/15 px-3 py-1 text-sm font-bold text-accent">IA locale</span>
                        </div>
                        <div class="rounded-2xl bg-white p-5 text-primary">
                            <p class="text-sm font-bold text-secondary">Ouagadougou · CDI</p>
                            <h2 class="mt-2 text-2xl font-black">Developpeur Symfony</h2>
                            <p class="mt-3 text-sm leading-6 text-slate-600">Votre CV a ete adapte automatiquement avec 5 competences fortes.</p>
                            <div class="mt-5 flex flex-wrap gap-2">
                                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold">PHP</span>
                                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold">Doctrine</span>
                                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold">MySQL</span>
                            </div>
                        </div>
                        <div class="mt-5 flex justify-center gap-5">
                            <span class="grid h-14 w-14 place-items-center rounded-full bg-rose-500 text-2xl shadow-lg">×</span>
                            <span class="grid h-14 w-14 place-items-center rounded-full bg-accent text-2xl shadow-lg">♥</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="features" class="mx-auto max-w-7xl px-5 py-24">
        <div class="fade-in mx-auto max-w-3xl text-center">
            <p class="font-black uppercase tracking-[0.2em] text-accent">Features</p>
            <h2 class="mt-4 text-4xl font-black text-primary sm:text-5xl">Tout le parcours candidat, simplifie.</h2>
        </div>
        <div class="mt-14 grid gap-6 md:grid-cols-3">
            {% for feature in [
                {title: 'Swipe intelligent', text: 'Les candidats explorent les offres avec une experience rapide, claire et mobile-first.', icon: '↔'},
                {title: 'CV automatique', text: 'KIBARE-JOB genere et adapte les CV aux offres avec une logique locale et economique.', icon: 'CV'},
                {title: 'Matching IA', text: 'Scores bases sur competences, localisation, experience et documents disponibles.', icon: 'AI'}
            ] %}
                <article class="fade-in rounded-2xl bg-white p-7 shadow-soft transition duration-300 hover:-translate-y-1 hover:scale-[1.02]">
                    <div class="grid h-14 w-14 place-items-center rounded-2xl bg-primary text-xl font-black text-accent">{{ feature.icon }}</div>
                    <h3 class="mt-6 text-2xl font-black text-primary">{{ feature.title }}</h3>
                    <p class="mt-4 leading-7 text-slate-600">{{ feature.text }}</p>
                </article>
            {% endfor %}
        </div>
    </section>

    <section id="how" class="bg-white py-24">
        <div class="mx-auto max-w-7xl px-5">
            <div class="fade-in max-w-2xl">
                <p class="font-black uppercase tracking-[0.2em] text-secondary">Comment ca marche</p>
                <h2 class="mt-4 text-4xl font-black text-primary sm:text-5xl">Trois etapes, une candidature solide.</h2>
            </div>
            <div class="mt-12 grid gap-6 md:grid-cols-3">
                {% for step in [
                    {number: '01', title: 'Creer profil', text: 'Le candidat renseigne son parcours ou genere un CV avec les questions guidees.'},
                    {number: '02', title: 'Swiper', text: 'Les offres pertinentes apparaissent en priorité, avec documents requis visibles.'},
                    {number: '03', title: 'Etre recrute', text: 'La candidature part avec CV adapte, lettre de motivation et documents utiles.'}
                ] %}
                    <article class="fade-in rounded-2xl border border-slate-100 bg-slate-50 p-8 transition duration-300 hover:scale-[1.02] hover:bg-white hover:shadow-soft">
                        <span class="text-5xl font-black text-accent">{{ step.number }}</span>
                        <h3 class="mt-6 text-2xl font-black text-primary">{{ step.title }}</h3>
                        <p class="mt-4 leading-7 text-slate-600">{{ step.text }}</p>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>
</main>
{% endblock %}
