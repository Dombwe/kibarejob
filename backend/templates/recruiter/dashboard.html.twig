{% extends 'recruiter/_layout.html.twig' %}

{% set active = 'dashboard' %}
{% block title %}Tableau de bord recruteur - KIBARE-JOB{% endblock %}

{% block recruiter_content %}
{% set stats = stats|default([
    { label: 'Candidatures', value: '112', change: '+12%', trend: 'up', color: 'primary', icon: 'users' },
    { label: 'Vues totales', value: '2 847', change: '+8%', trend: 'up', color: 'accent', icon: 'eye' },
    { label: 'Entretiens', value: '12', change: '+25%', trend: 'up', color: 'secondary', icon: 'calendar' },
    { label: 'Recrutements', value: '3', change: '-50%', trend: 'down', color: 'neutral', icon: 'check' }
]) %}
{% set weekData = weekData|default([
    { day: 'Lun', value: 12, height: 43 }, { day: 'Mar', value: 19, height: 68 },
    { day: 'Mer', value: 15, height: 54 }, { day: 'Jeu', value: 28, height: 100 },
    { day: 'Ven', value: 24, height: 86 }, { day: 'Sam', value: 8, height: 29 },
    { day: 'Dim', value: 3, height: 11 }
]) %}
{% set statusData = statusData|default([
    { name: 'Nouvelles', value: 45, percent: 40, color: 'bg-secondary' },
    { name: 'Consultees', value: 32, percent: 29, color: 'bg-accent' },
    { name: 'Entretiens', value: 12, percent: 11, color: 'bg-secondary/70' },
    { name: 'Recrutees', value: 8, percent: 7, color: 'bg-primary' },
    { name: 'Rejetees', value: 15, percent: 13, color: 'bg-slate-500' }
]) %}
{% set recentApplications = recentApplications|default([
    { candidate: 'Mamadou Sawadogo', avatar: 'MS', job: 'Developpeur Web Full Stack', status: 'Nouvelle', tone: 'primary', matchScore: 92, appliedAt: '2h' },
    { candidate: 'Awa Ouedraogo', avatar: 'AO', job: 'Responsable Marketing', status: 'Entretien', tone: 'secondary', matchScore: 85, appliedAt: '5h' },
    { candidate: 'Ibrahim Traore', avatar: 'IT', job: 'Comptable Senior', status: 'Nouvelle', tone: 'primary', matchScore: 78, appliedAt: '1j' },
    { candidate: 'Fatou Coulibaly', avatar: 'FC', job: 'Chef de Projet', status: 'Vue', tone: 'accent', matchScore: 88, appliedAt: '2j' }
]) %}
{% set topJobs = topJobs|default([
    { title: 'Developpeur Web Full Stack', applications: 24, views: 156, avgScore: 82 },
    { title: 'Responsable Marketing Digital', applications: 18, views: 98, avgScore: 75 },
    { title: 'Comptable Senior', applications: 12, views: 67, avgScore: 79 }
]) %}
{% set periodFilter = periodFilter|default({ period: 'week', label: 'Cette semaine', start: '', end: '' }) %}

<div class="p-4 lg:p-8">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="fade-in">
            <h1 class="text-2xl font-black text-slate-950">Tableau de bord</h1>
            <p class="mt-1 font-semibold text-slate-500">Bienvenue sur votre espace recruteur - {{ periodFilter.label }}</p>
        </div>
        <a href="{{ path('recruiter_offer_new') }}" class="fade-in inline-flex items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-secondary to-primary px-6 py-3 font-black text-white shadow-lg shadow-secondary/20 transition hover:-translate-y-0.5">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            Publier une offre
        </a>
    </div>

    <form method="get" action="{{ path('recruiter_dashboard') }}" class="fade-in mb-8 rounded-3xl bg-white p-4 shadow-sm ring-1 ring-slate-100">
        <div class="grid gap-4 lg:grid-cols-[1.2fr_1fr_1fr_auto_auto] lg:items-end">
            <div>
                <label for="period" class="mb-2 block text-xs font-black uppercase tracking-wide text-slate-400">Periode</label>
                <select id="period" name="period" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-black text-slate-700 outline-none transition focus:border-secondary focus:bg-white">
                    <option value="week" {% if periodFilter.period == 'week' %}selected{% endif %}>Hebdomadaire</option>
                    <option value="month" {% if periodFilter.period == 'month' %}selected{% endif %}>Mensuel</option>
                    <option value="quarter" {% if periodFilter.period == 'quarter' %}selected{% endif %}>Trimestriel</option>
                    <option value="semester" {% if periodFilter.period == 'semester' %}selected{% endif %}>Semestriel</option>
                    <option value="year" {% if periodFilter.period == 'year' %}selected{% endif %}>Annuel</option>
                    <option value="custom" {% if periodFilter.period == 'custom' %}selected{% endif %}>Periode personnalisee</option>
                </select>
            </div>
            <div>
                <label for="start" class="mb-2 block text-xs font-black uppercase tracking-wide text-slate-400">Date de debut</label>
                <input id="start" name="start" type="date" value="{{ periodFilter.start }}" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-black text-slate-700 outline-none transition focus:border-secondary focus:bg-white">
            </div>
            <div>
                <label for="end" class="mb-2 block text-xs font-black uppercase tracking-wide text-slate-400">Date de fin</label>
                <input id="end" name="end" type="date" value="{{ periodFilter.end }}" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-black text-slate-700 outline-none transition focus:border-secondary focus:bg-white">
            </div>
            <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-primary px-5 py-3 text-sm font-black text-white shadow-lg shadow-primary/15 transition hover:-translate-y-0.5">
                Filtrer
            </button>
            <a href="{{ path('recruiter_dashboard') }}" class="inline-flex items-center justify-center rounded-2xl bg-slate-100 px-5 py-3 text-sm font-black text-slate-600 transition hover:bg-slate-200">
                Reinitialiser
            </a>
        </div>
        <p class="mt-3 text-xs font-semibold text-slate-400">Pour une periode personnalisee, choisissez une date de debut et une date de fin, puis cliquez sur Filtrer.</p>
    </form>

    <div class="mb-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
        {% for stat in stats %}
            <article class="fade-in rounded-3xl bg-white p-5 shadow-sm ring-1 ring-slate-100">
                <div class="mb-3 flex items-center justify-between">
                    <div class="grid h-10 w-10 place-items-center rounded-2xl {% if stat.color == 'primary' %}bg-primary/10 text-primary{% elseif stat.color == 'accent' %}bg-accent/35 text-primary{% elseif stat.color == 'secondary' %}bg-secondary/15 text-secondary{% else %}bg-slate-100 text-slate-600{% endif %}">
                        {% if stat.icon == 'users' %}
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 21v-2a4 4 0 0 0-3-3.87" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                        {% elseif stat.icon == 'eye' %}
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" stroke="currentColor" stroke-width="2"/><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" stroke="currentColor" stroke-width="2"/></svg>
                        {% elseif stat.icon == 'calendar' %}
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                        {% else %}
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="m20 6-11 11-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                        {% endif %}
                    </div>
                    <div class="flex items-center gap-1 text-sm font-black {% if stat.trend == 'up' %}text-secondary{% else %}text-slate-600{% endif %}">
                        {{ stat.trend == 'up' ? '↗' : '↘' }} {{ stat.change }}
                    </div>
                </div>
                <div class="text-3xl font-black text-slate-950">{{ stat.value }}</div>
                <div class="text-sm font-semibold text-slate-500">{{ stat.label }}</div>
            </article>
        {% endfor %}
    </div>

    <div class="mb-8 grid gap-6 lg:grid-cols-3">
        <article class="fade-in rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-100 lg:col-span-2">
            <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                <div>
                    <h2 class="text-lg font-black text-slate-950">Candidatures sur la periode</h2>
                    <p class="mt-1 text-sm font-semibold text-slate-500">Evolution des candidatures recues - {{ periodFilter.label }}.</p>
                </div>
                <span class="inline-flex w-fit items-center rounded-full bg-secondary/10 px-3 py-1 text-xs font-black uppercase tracking-wide text-primary">{{ periodFilter.label }}</span>
            </div>
            <div class="rounded-3xl border border-slate-100 bg-gradient-to-b from-slate-50 to-white p-5">
                <div class="mb-4 flex items-center justify-between rounded-2xl bg-white px-4 py-3 shadow-sm ring-1 ring-slate-100">
                    <div>
                        <p class="text-xs font-black uppercase tracking-wide text-slate-400">Total candidatures</p>
                        <p class="text-2xl font-black text-slate-950">{{ stats[0].value }}</p>
                    </div>
                    <div class="text-right">
                        <p class="text-xs font-black uppercase tracking-wide text-slate-400">Tendance</p>
                        <p class="font-black text-secondary">{{ stats[0].change }}</p>
                    </div>
                </div>
                <div class="relative h-64 overflow-x-auto pb-2">
                    <div class="absolute inset-x-0 top-1/4 h-px bg-slate-200/80"></div>
                    <div class="absolute inset-x-0 top-1/2 h-px bg-slate-200/80"></div>
                    <div class="absolute inset-x-0 top-3/4 h-px bg-slate-200/80"></div>
                    <div class="relative flex h-full min-w-[620px] items-end justify-between gap-3">
                        {% for item in weekData %}
                            <div class="group flex h-full flex-1 flex-col items-center justify-end gap-3">
                                <span class="rounded-full bg-white px-2 py-1 text-xs font-black text-slate-600 shadow-sm ring-1 ring-slate-100">{{ item.value }}</span>
                                <span class="flex h-44 w-full max-w-12 items-end rounded-full bg-slate-100 p-1">
                                    <span class="w-full rounded-full bg-gradient-to-t from-secondary to-primary shadow-lg shadow-secondary/15 transition group-hover:from-primary group-hover:to-secondary" style="height: {{ item.height }}%; min-height: 12px;"></span>
                                </span>
                                <span class="text-xs font-black uppercase tracking-wide text-slate-400">{{ item.day }}</span>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </article>

        <article class="fade-in rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-100">
            <div class="mb-6">
                <h2 class="text-lg font-black text-slate-950">Statut des candidatures</h2>
                <p class="mt-1 text-sm font-semibold text-slate-500">Repartition du pipeline de recrutement.</p>
            </div>
            <div class="mb-6 rounded-3xl border border-slate-100 bg-slate-50 p-4">
                <div class="mb-3 flex items-end justify-between">
                    <div>
                        <p class="text-xs font-black uppercase tracking-wide text-slate-400">Volume total</p>
                        <p class="text-3xl font-black text-slate-950">{{ stats[0].value }}</p>
                    </div>
                    <p class="text-sm font-black text-slate-500">100%</p>
                </div>
                <div class="flex h-3 overflow-hidden rounded-full bg-white ring-1 ring-slate-100">
                    {% for item in statusData %}
                        <span class="{{ item.color }}" style="width: {{ item.percent|default(0) }}%;"></span>
                    {% endfor %}
                </div>
            </div>
            <div class="grid gap-3">
                {% for item in statusData %}
                    <div class="rounded-2xl bg-slate-50 p-3 ring-1 ring-slate-100">
                        <div class="mb-2 flex items-center gap-2 text-sm">
                            <span class="h-3 w-3 rounded-full {{ item.color }}"></span>
                            <span class="font-black text-slate-700">{{ item.name }}</span>
                            <span class="ml-auto font-black text-slate-950">{{ item.value }}</span>
                            <span class="w-10 text-right text-xs font-black text-slate-400">{{ item.percent|default(0) }}%</span>
                        </div>
                        <div class="h-1.5 overflow-hidden rounded-full bg-white">
                            <span class="block h-full rounded-full {{ item.color }}" style="width: {{ item.percent|default(0) }}%;"></span>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </article>
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
        <article class="fade-in rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-100">
            <div class="mb-6 flex items-start justify-between gap-4">
                <div>
                    <h2 class="text-lg font-black text-slate-950">Candidatures recentes</h2>
                    <p class="mt-1 text-sm font-semibold text-slate-500">Les derniers profils recus avec leur score de match.</p>
                </div>
                <a href="{{ path('recruiter_applications') }}" class="shrink-0 rounded-full bg-secondary/10 px-3 py-1 text-sm font-black text-primary">Voir tout</a>
            </div>
            <div class="space-y-3">
                {% for app in recentApplications %}
                    <a href="{{ path('recruiter_applications') }}" class="group block rounded-3xl border border-slate-100 bg-slate-50/70 p-4 transition hover:-translate-y-0.5 hover:bg-white hover:shadow-lg hover:shadow-slate-200/70">
                        <div class="flex items-start gap-4">
                            <div class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-secondary to-primary font-black text-white shadow-lg shadow-secondary/15">{{ app.avatar }}</div>
                            <div class="min-w-0 flex-1">
                                <div class="mb-1 flex min-w-0 items-center gap-2">
                                    <span class="truncate font-black text-slate-800">{{ app.candidate }}</span>
                                    <span class="shrink-0 rounded-full px-2 py-0.5 text-xs font-black {% if app.tone == 'primary' %}bg-primary/10 text-primary{% elseif app.tone == 'secondary' %}bg-secondary/15 text-primary{% else %}bg-accent/30 text-primary{% endif %}">{{ app.status }}</span>
                                </div>
                                <p class="truncate text-sm font-semibold text-slate-500">{{ app.job }}</p>
                                <div class="mt-3 flex items-center gap-3">
                                    <div class="h-2 flex-1 overflow-hidden rounded-full bg-white ring-1 ring-slate-100">
                                        <span class="block h-full rounded-full bg-gradient-to-r from-secondary to-primary" style="width: {{ app.matchScore }}%;"></span>
                                    </div>
                                    <span class="text-sm font-black text-primary">{{ app.matchScore }}%</span>
                                </div>
                            </div>
                            <span class="rounded-full bg-white px-2 py-1 text-xs font-black text-slate-400 ring-1 ring-slate-100">il y a {{ app.appliedAt }}</span>
                        </div>
                    </a>
                {% else %}
                    <div class="rounded-2xl bg-slate-50 p-5 text-sm font-semibold text-slate-500">Aucune candidature recue pour le moment.</div>
                {% endfor %}
            </div>
        </article>

        <article class="fade-in rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-100">
            <div class="mb-6 flex items-start justify-between gap-4">
                <div>
                    <h2 class="text-lg font-black text-slate-950">Mes offres les plus attractives</h2>
                    <p class="mt-1 text-sm font-semibold text-slate-500">Classement selon candidatures, vues et score moyen.</p>
                </div>
                <a href="{{ path('recruiter_offers') }}" class="shrink-0 rounded-full bg-secondary/10 px-3 py-1 text-sm font-black text-primary">Voir tout</a>
            </div>
            <div class="space-y-3">
                {% for job in topJobs %}
                    <div class="rounded-3xl border border-slate-100 bg-slate-50/70 p-4 transition hover:bg-white hover:shadow-lg hover:shadow-slate-200/70">
                        <div class="flex items-start gap-4">
                            <div class="grid h-10 w-10 shrink-0 place-items-center rounded-2xl bg-primary text-sm font-black text-white shadow-lg shadow-primary/15">#{{ loop.index }}</div>
                            <div class="min-w-0 flex-1">
                                <p class="truncate font-black text-slate-800">{{ job.title }}</p>
                                <div class="mt-2 flex flex-wrap gap-2 text-xs font-black text-slate-600">
                                    <span class="rounded-full bg-white px-3 py-1 ring-1 ring-slate-100">{{ job.applications }} candidatures</span>
                                    <span class="rounded-full bg-white px-3 py-1 ring-1 ring-slate-100">{{ job.views }} vues</span>
                                </div>
                                <div class="mt-4">
                                    <div class="mb-1 flex items-center justify-between text-xs font-black uppercase tracking-wide text-slate-400">
                                        <span>Score moyen</span>
                                        <span class="text-primary">{{ job.avgScore }}%</span>
                                    </div>
                                    <div class="h-2 overflow-hidden rounded-full bg-white ring-1 ring-slate-100">
                                        <span class="block h-full rounded-full bg-gradient-to-r from-secondary to-primary" style="width: {{ job.avgScore }}%;"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="rounded-2xl bg-slate-50 p-5 text-sm font-semibold text-slate-500">Aucune offre publiee pour le moment.</div>
                {% endfor %}
            </div>
        </article>
    </div>
</div>
{% endblock %}
