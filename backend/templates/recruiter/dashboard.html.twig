{% extends 'recruiter/_layout.html.twig' %}

{% set active = 'dashboard' %}
{% block title %}Tableau de bord recruteur - KIBARE-JOB{% endblock %}

{% block recruiter_content %}
{% set stats = [
    { label: 'Candidatures', value: '112', change: '+12%', trend: 'up', color: 'primary', icon: 'users' },
    { label: 'Vues totales', value: '2 847', change: '+8%', trend: 'up', color: 'accent', icon: 'eye' },
    { label: 'Entretiens', value: '12', change: '+25%', trend: 'up', color: 'secondary', icon: 'calendar' },
    { label: 'Recrutements', value: '3', change: '-50%', trend: 'down', color: 'neutral', icon: 'check' }
] %}
{% set weekData = [
    { day: 'Lun', value: 12, height: 43 }, { day: 'Mar', value: 19, height: 68 },
    { day: 'Mer', value: 15, height: 54 }, { day: 'Jeu', value: 28, height: 100 },
    { day: 'Ven', value: 24, height: 86 }, { day: 'Sam', value: 8, height: 29 },
    { day: 'Dim', value: 3, height: 11 }
] %}
{% set statusData = [
    { name: 'Nouvelles', value: 45, color: 'bg-secondary' },
    { name: 'Consultees', value: 32, color: 'bg-accent' },
    { name: 'Entretiens', value: 12, color: 'bg-secondary' },
    { name: 'Recrutees', value: 8, color: 'bg-accent' },
    { name: 'Rejetees', value: 15, color: 'bg-slate-500' }
] %}
{% set recentApplications = [
    { candidate: 'Mamadou Sawadogo', avatar: 'MS', job: 'Developpeur Web Full Stack', status: 'Nouvelle', tone: 'primary', matchScore: 92, appliedAt: '2h' },
    { candidate: 'Awa Ouedraogo', avatar: 'AO', job: 'Responsable Marketing', status: 'Entretien', tone: 'secondary', matchScore: 85, appliedAt: '5h' },
    { candidate: 'Ibrahim Traore', avatar: 'IT', job: 'Comptable Senior', status: 'Nouvelle', tone: 'primary', matchScore: 78, appliedAt: '1j' },
    { candidate: 'Fatou Coulibaly', avatar: 'FC', job: 'Chef de Projet', status: 'Vue', tone: 'accent', matchScore: 88, appliedAt: '2j' }
] %}
{% set topJobs = [
    { title: 'Developpeur Web Full Stack', applications: 24, views: 156, avgScore: 82 },
    { title: 'Responsable Marketing Digital', applications: 18, views: 98, avgScore: 75 },
    { title: 'Comptable Senior', applications: 12, views: 67, avgScore: 79 }
] %}

<div class="p-4 lg:p-8">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="fade-in">
            <h1 class="text-2xl font-black text-slate-950">Tableau de bord</h1>
            <p class="mt-1 font-semibold text-slate-500">Bienvenue sur votre espace recruteur</p>
        </div>
        <a href="{{ path('recruiter_offer_new') }}" class="fade-in inline-flex items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-secondary to-primary px-6 py-3 font-black text-white shadow-lg shadow-secondary/20 transition hover:-translate-y-0.5">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            Publier une offre
        </a>
    </div>

    <div class="mb-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
        {% for stat in stats %}
            <article class="fade-in rounded-3xl bg-white p-5 shadow-sm ring-1 ring-slate-100">
                <div class="mb-3 flex items-center justify-between">
                    <div class="grid h-10 w-10 place-items-center rounded-2xl {% if stat.color == 'primary' %}bg-primary/10 text-primary{% elseif stat.color == 'accent' %}bg-accent/35 text-primary{% elseif stat.color == 'secondary' %}bg-secondary/15 text-secondary{% else %}bg-slate-100 text-slate-600{% endif %}">
                        {% if stat.icon == 'users' %}
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 21v-2a4 4 0 0 0-3-3.87" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                        {% elseif stat.icon == 'eye' %}
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" stroke="currentColor" stroke-width="2"/><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" stroke="currentColor" stroke-width="2"/></svg>
                        {% elseif stat.icon == 'calendar' %}
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                        {% else %}
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="m20 6-11 11-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                        {% endif %}
                    </div>
                    <div class="flex items-center gap-1 text-sm font-black {% if stat.trend == 'up' %}text-secondary{% else %}text-slate-600{% endif %}">
                        {{ stat.trend == 'up' ? '↗' : '↘' }} {{ stat.change }}
                    </div>
                </div>
                <div class="text-3xl font-black text-slate-950">{{ stat.value }}</div>
                <div class="text-sm font-semibold text-slate-500">{{ stat.label }}</div>
            </article>
        {% endfor %}
    </div>

    <div class="mb-8 grid gap-6 lg:grid-cols-3">
        <article class="fade-in rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-100 lg:col-span-2">
            <div class="mb-6 flex items-center justify-between gap-4">
                <h2 class="text-lg font-black text-slate-950">Candidatures cette semaine</h2>
                <select class="rounded-xl bg-slate-100 px-3 py-2 text-sm font-semibold text-slate-600 outline-none">
                    <option>Cette semaine</option>
                    <option>Ce mois</option>
                    <option>Cette annee</option>
                </select>
            </div>
            <div class="relative h-64 rounded-3xl bg-gradient-to-b from-secondary/10 to-white p-5">
                <div class="absolute inset-x-5 top-1/4 h-px bg-slate-200"></div>
                <div class="absolute inset-x-5 top-1/2 h-px bg-slate-200"></div>
                <div class="absolute inset-x-5 top-3/4 h-px bg-slate-200"></div>
                <div class="relative flex h-full items-end justify-between gap-3">
                    {% for item in weekData %}
                        <div class="flex h-full flex-1 flex-col items-center justify-end gap-3">
                            <span class="w-full max-w-12 rounded-t-2xl bg-gradient-to-t from-secondary to-primary shadow-lg shadow-secondary/20" style="height: {{ item.height }}%; min-height: 12px;"></span>
                            <span class="text-xs font-bold text-slate-400">{{ item.day }}</span>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </article>

        <article class="fade-in rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-100">
            <h2 class="mb-6 text-lg font-black text-slate-950">Statut des candidatures</h2>
            <div class="mx-auto mb-6 grid h-44 w-44 place-items-center rounded-full bg-[conic-gradient(#5F7F99_0_40%,#B8C7B4_40%_69%,#8496A6_69%_80%,#D6D0C5_80%_87%,#64748B_87%_100%)]">
                <div class="grid h-24 w-24 place-items-center rounded-full bg-white text-center shadow-inner">
                    <span class="text-2xl font-black text-slate-950">112</span>
                    <span class="-mt-3 text-xs font-bold text-slate-400">Total</span>
                </div>
            </div>
            <div class="grid gap-2">
                {% for item in statusData %}
                    <div class="flex items-center gap-2 rounded-2xl bg-slate-50 px-3 py-2 text-sm">
                        <span class="h-3 w-3 rounded-full {{ item.color }}"></span>
                        <span class="font-semibold text-slate-600">{{ item.name }}</span>
                        <span class="ml-auto font-black text-slate-950">{{ item.value }}</span>
                    </div>
                {% endfor %}
            </div>
        </article>
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
        <article class="fade-in rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-100">
            <div class="mb-6 flex items-center justify-between">
                <h2 class="text-lg font-black text-slate-950">Candidatures recentes</h2>
                <a href="{{ path('recruiter_applications') }}" class="text-sm font-black text-secondary">Voir tout</a>
            </div>
            <div class="space-y-3">
                {% for app in recentApplications %}
                    <a href="{{ path('recruiter_applications') }}" class="flex items-center gap-4 rounded-2xl p-3 transition hover:bg-slate-50">
                        <div class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-gradient-to-br from-secondary to-primary font-black text-white">{{ app.avatar }}</div>
                        <div class="min-w-0 flex-1">
                            <div class="flex min-w-0 items-center gap-2">
                                <span class="truncate font-black text-slate-800">{{ app.candidate }}</span>
                                    <span class="shrink-0 rounded-full px-2 py-0.5 text-xs font-black {% if app.tone == 'primary' %}bg-primary/10 text-primary{% elseif app.tone == 'secondary' %}bg-secondary/15 text-primary{% else %}bg-accent/30 text-primary{% endif %}">{{ app.status }}</span>
                            </div>
                            <p class="truncate text-sm font-semibold text-slate-500">{{ app.job }}</p>
                        </div>
                        <div class="text-right">
                            <div class="text-lg font-black text-secondary">{{ app.matchScore }}%</div>
                            <div class="text-xs font-semibold text-slate-400">il y a {{ app.appliedAt }}</div>
                        </div>
                    </a>
                {% endfor %}
            </div>
        </article>

        <article class="fade-in rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-100">
            <div class="mb-6 flex items-center justify-between">
                <h2 class="text-lg font-black text-slate-950">Mes offres les plus attractives</h2>
                <a href="{{ path('recruiter_offers') }}" class="text-sm font-black text-secondary">Voir tout</a>
            </div>
            <div class="space-y-3">
                {% for job in topJobs %}
                    <div class="flex items-center gap-4 rounded-2xl bg-slate-50 p-4 transition hover:bg-slate-100">
                        <div class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-secondary text-sm font-black text-white">{{ loop.index }}</div>
                        <div class="min-w-0 flex-1">
                            <p class="truncate font-black text-slate-800">{{ job.title }}</p>
                            <div class="mt-1 flex items-center gap-4 text-sm font-semibold text-slate-500">
                                <span>{{ job.applications }} candidatures</span>
                                <span>{{ job.views }} vues</span>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-lg font-black text-secondary">{{ job.avgScore }}%</div>
                            <div class="text-xs font-semibold text-slate-400">score moyen</div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </article>
    </div>
</div>
{% endblock %}
