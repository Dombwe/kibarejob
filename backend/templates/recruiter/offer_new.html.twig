{% extends 'recruiter/_layout.html.twig' %}

{% set active = 'offers' %}
{% block title %}Publier une offre - KIBARE-JOB{% endblock %}

{% block recruiter_content %}
{% set contracts = ['CDI', 'CDD', 'Stage', 'Freelance', 'Contrat local'] %}
{% set educations = ['Aucun', 'CEP', 'BEPC', 'Bac', 'Licence', 'Master', 'Doctorat'] %}
{% set skills = ['JavaScript', 'React', 'Node.js', 'Python', 'Symfony', 'Marketing Digital', 'SEO', 'Gestion de projet', 'Leadership', 'Excel'] %}

<div class="min-h-[calc(100vh-73px)] bg-slate-50">
    <div class="border-b border-slate-200 bg-white">
        <div class="mx-auto max-w-4xl px-4 py-5">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div class="grid h-11 w-11 place-items-center rounded-2xl bg-gradient-to-br from-secondary to-primary text-white">
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none"><path d="M10 6h4a2 2 0 0 1 2 2v1h3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3V8a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2"/></svg>
                    </div>
                    <div>
                        <h1 class="font-black text-slate-950">Publier une offre</h1>
                        <p class="text-sm font-semibold text-slate-500">Formulaire en 2 sections</p>
                    </div>
                </div>
                <a href="{{ path('recruiter_offers') }}" class="rounded-xl p-2 text-slate-500 transition hover:bg-slate-100" aria-label="Fermer"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none"><path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></a>
            </div>
            <div class="mt-5 h-1 overflow-hidden rounded-full bg-slate-200"><div class="h-full w-full rounded-full bg-gradient-to-r from-secondary to-primary"></div></div>
        </div>
    </div>

    <main class="mx-auto max-w-4xl px-4 py-8">
        <form class="space-y-6">
            <section class="fade-in rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-100">
                <h2 class="mb-6 text-xl font-black text-slate-950">Informations de l'offre</h2>
                <div class="space-y-6">
                    <label class="block">
                        <span class="mb-2 block text-sm font-black text-slate-700">Titre du poste *</span>
                        <input class="w-full rounded-2xl border border-slate-200 px-4 py-3 font-semibold outline-none focus:ring-4 focus:ring-secondary/20" placeholder="Ex: Developpeur Web Full Stack">
                    </label>
                    <label class="block">
                        <span class="mb-2 block text-sm font-black text-slate-700">Description du poste *</span>
                        <textarea rows="6" class="w-full rounded-2xl border border-slate-200 px-4 py-3 font-semibold outline-none focus:ring-4 focus:ring-secondary/20" placeholder="Decrivez le poste, l'entreprise, les attentes..."></textarea>
                    </label>
                    <div>
                        <span class="mb-2 block text-sm font-black text-slate-700">Missions principales</span>
                        <div class="space-y-2">
                            <input class="w-full rounded-2xl border border-slate-200 px-4 py-3 font-semibold outline-none focus:ring-4 focus:ring-secondary/20" placeholder="Mission 1">
                            <input class="w-full rounded-2xl border border-slate-200 px-4 py-3 font-semibold outline-none focus:ring-4 focus:ring-secondary/20" placeholder="Mission 2">
                        </div>
                        <button type="button" class="mt-3 inline-flex items-center gap-2 text-sm font-black text-secondary">+ Ajouter une mission</button>
                    </div>
                    <div class="grid gap-6 md:grid-cols-2">
                        <div>
                            <span class="mb-2 block text-sm font-black text-slate-700">Type de contrat *</span>
                            <div class="flex flex-wrap gap-2">
                                {% for contract in contracts %}<button type="button" class="rounded-xl px-4 py-2 text-sm font-black {% if loop.first %}bg-secondary text-white{% else %}bg-slate-100 text-slate-700{% endif %}">{{ contract }}</button>{% endfor %}
                            </div>
                        </div>
                        <label class="block">
                            <span class="mb-2 block text-sm font-black text-slate-700">Lieu de travail *</span>
                            <input class="w-full rounded-2xl border border-slate-200 px-4 py-3 font-semibold outline-none focus:ring-4 focus:ring-secondary/20" placeholder="Ex: Ouagadougou">
                        </label>
                    </div>
                    <div class="grid gap-6 md:grid-cols-2">
                        <label class="flex items-center justify-between rounded-2xl bg-slate-50 p-4">
                            <span><span class="block font-black">Teletravail autorise</span><span class="text-sm font-semibold text-slate-500">Optionnel</span></span>
                            <input type="checkbox" class="h-5 w-5 rounded text-secondary">
                        </label>
                        <label class="block">
                            <span class="mb-2 block text-sm font-black text-slate-700">Date limite</span>
                            <input type="date" class="w-full rounded-2xl border border-slate-200 px-4 py-3 font-semibold outline-none focus:ring-4 focus:ring-secondary/20">
                        </label>
                    </div>
                    <div>
                        <span class="mb-2 block text-sm font-black text-slate-700">Salaire (FCFA/mois)</span>
                        <div class="flex items-center gap-4">
                            <input type="number" class="min-w-0 flex-1 rounded-2xl border border-slate-200 px-4 py-3 font-semibold outline-none focus:ring-4 focus:ring-secondary/20" placeholder="Min">
                            <span class="font-black text-slate-400">a</span>
                            <input type="number" class="min-w-0 flex-1 rounded-2xl border border-slate-200 px-4 py-3 font-semibold outline-none focus:ring-4 focus:ring-secondary/20" placeholder="Max">
                        </div>
                    </div>
                </div>
            </section>

            <section class="fade-in rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-100">
                <h2 class="mb-6 text-xl font-black text-slate-950">Profil recherche</h2>
                <div class="space-y-6">
                    <div>
                        <span class="mb-2 block text-sm font-black text-slate-700">Niveau d'etudes minimum *</span>
                        <div class="flex flex-wrap gap-2">{% for level in educations %}<button type="button" class="rounded-xl px-4 py-2 text-sm font-black {% if level == 'Licence' %}bg-secondary text-white{% else %}bg-slate-100 text-slate-700{% endif %}">{{ level }}</button>{% endfor %}</div>
                    </div>
                    <div>
                        <span class="mb-2 block text-sm font-black text-slate-700">Competences requises *</span>
                        <div class="mb-3 flex flex-wrap gap-2">
                            {% for skill in ['JavaScript','React','Node.js'] %}<span class="rounded-full bg-secondary/15 px-3 py-1.5 text-sm font-black text-primary">{{ skill }} <button type="button">x</button></span>{% endfor %}
                        </div>
                        <div class="flex gap-2">
                            <input class="min-w-0 flex-1 rounded-2xl border border-slate-200 px-4 py-3 font-semibold outline-none focus:ring-4 focus:ring-secondary/20" placeholder="Ajouter une competence...">
                            <button type="button" class="rounded-2xl bg-secondary px-4 py-3 font-black text-white">Ajouter</button>
                        </div>
                        <div class="mt-3 flex flex-wrap gap-2">
                            {% for skill in skills %}<button type="button" class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600 hover:bg-secondary/10 hover:text-secondary">+ {{ skill }}</button>{% endfor %}
                        </div>
                    </div>
                </div>
            </section>

            <section class="fade-in rounded-3xl bg-gradient-to-r from-secondary/10 to-accent/20 p-6">
                <h3 class="mb-4 font-black text-slate-950">Apercu de votre offre</h3>
                <div class="rounded-2xl bg-white p-4">
                    <p class="text-lg font-black">Developpeur Web Full Stack</p>
                    <p class="mt-1 text-sm font-semibold text-slate-500">CDI · Ouagadougou</p>
                    <p class="mt-2 text-sm leading-6 text-slate-500">Votre offre apparaitra dans le feed candidat avec le score de matching et les documents requis.</p>
                </div>
            </section>

            <div class="flex justify-end">
                <button type="button" class="rounded-2xl bg-gradient-to-r from-secondary to-primary px-8 py-3 font-black text-white shadow-lg shadow-secondary/20">Publier l'offre</button>
            </div>
        </form>
    </main>
</div>
{% endblock %}
