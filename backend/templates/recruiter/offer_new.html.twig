{% extends 'recruiter/_layout.html.twig' %}

{% set active = 'offers' %}
{% block title %}Publier une offre - KIBARE-JOB{% endblock %}

{% block recruiter_content %}
{% set contracts = ['CDI', 'CDD', 'Stage', 'Freelance', 'Prestation'] %}
{% set educations = ['Aucun', 'CEP', 'BEPC', 'Bac', 'Licence', 'Master', 'Doctorat'] %}
{% set skills = ['JavaScript', 'React', 'Node.js', 'Python', 'Symfony', 'Marketing Digital', 'SEO', 'Gestion de projet', 'Leadership', 'Excel'] %}

<div class="min-h-[calc(100vh-73px)] bg-slate-50">
    <div class="border-b border-slate-200 bg-white">
        <div class="mx-auto max-w-4xl px-4 py-5">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div class="grid h-11 w-11 place-items-center rounded-2xl bg-gradient-to-br from-secondary to-primary text-white">
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none"><path d="M10 6h4a2 2 0 0 1 2 2v1h3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3V8a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2"/></svg>
                    </div>
                    <div>
                        <h1 class="font-black text-slate-950">Publier une offre</h1>
                        <p class="text-sm font-semibold text-slate-500">Formulaire en 2 sections</p>
                    </div>
                </div>
                <a href="{{ path('recruiter_offers') }}" class="rounded-xl p-2 text-slate-500 transition hover:bg-slate-100" aria-label="Fermer"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none"><path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></a>
            </div>
            <div class="mt-5 h-1 overflow-hidden rounded-full bg-slate-200"><div class="h-full w-full rounded-full bg-gradient-to-r from-secondary to-primary"></div></div>
        </div>
    </div>

    <main class="mx-auto max-w-4xl px-4 py-8">
        <form class="space-y-6" method="post">
            <section class="fade-in rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-100">
                <h2 class="mb-6 text-xl font-black text-slate-950">Informations de l'offre</h2>
                {% if errors|default([]) is not empty %}
                    <div class="mb-6 rounded-2xl bg-slate-100 px-4 py-3 text-sm font-semibold text-slate-700">Certains champs obligatoires sont incomplets. Verifiez le formulaire puis reessayez.</div>
                {% endif %}
                <div class="space-y-6">
                    <label class="block">
                        <span class="mb-2 block text-sm font-black text-slate-700">Titre du poste *</span>
                        <input name="title" class="w-full rounded-2xl border border-slate-200 px-4 py-3 font-semibold outline-none focus:ring-4 focus:ring-secondary/20" placeholder="Ex: Developpeur Web Full Stack" required>
                    </label>
                    <label class="block">
                        <span class="mb-2 block text-sm font-black text-slate-700">Description du poste *</span>
                        <textarea name="description" rows="6" class="w-full rounded-2xl border border-slate-200 px-4 py-3 font-semibold outline-none focus:ring-4 focus:ring-secondary/20" placeholder="Decrivez le poste, l'entreprise, les attentes..." required></textarea>
                    </label>
                    <div data-missions-builder>
                        <span class="mb-2 block text-sm font-black text-slate-700">Missions principales</span>
                        <div class="space-y-2" data-missions-list>
                            <div class="flex gap-2" data-mission-row>
                                <input name="missions[]" class="w-full rounded-2xl border border-slate-200 px-4 py-3 font-semibold outline-none focus:ring-4 focus:ring-secondary/20" placeholder="Mission 1">
                            </div>
                            <div class="flex gap-2" data-mission-row>
                                <input name="missions[]" class="w-full rounded-2xl border border-slate-200 px-4 py-3 font-semibold outline-none focus:ring-4 focus:ring-secondary/20" placeholder="Mission 2">
                            </div>
                        </div>
                        <button type="button" class="mt-3 inline-flex items-center gap-2 text-sm font-black text-secondary transition hover:text-primary" data-add-mission>+ Ajouter une mission</button>
                    </div>
                    <div class="grid gap-6 md:grid-cols-2">
                        <div>
                            <label class="block">
                                <span class="mb-2 block text-sm font-black text-slate-700">Type de contrat *</span>
                                <select name="contractType" class="w-full rounded-2xl border border-slate-200 px-4 py-3 font-semibold outline-none focus:ring-4 focus:ring-secondary/20">
                                    {% for contract in contracts %}<option value="{{ contract }}">{{ contract }}</option>{% endfor %}
                                </select>
                            </label>
                        </div>
                        <label class="block">
                            <span class="mb-2 block text-sm font-black text-slate-700">Lieu de travail *</span>
                            <input name="location" class="w-full rounded-2xl border border-slate-200 px-4 py-3 font-semibold outline-none focus:ring-4 focus:ring-secondary/20" placeholder="Ex: Ouagadougou" required>
                        </label>
                    </div>
                    <div class="grid gap-6 md:grid-cols-2">
                        <label class="flex items-center justify-between rounded-2xl bg-slate-50 p-4">
                            <span><span class="block font-black">Teletravail autorise</span><span class="text-sm font-semibold text-slate-500">Optionnel</span></span>
                            <input type="checkbox" name="isRemoteAllowed" value="1" class="h-5 w-5 rounded text-secondary">
                        </label>
                        <label class="block">
                            <span class="mb-2 block text-sm font-black text-slate-700">Date limite</span>
                            <input type="date" name="deadline" class="w-full rounded-2xl border border-slate-200 px-4 py-3 font-semibold outline-none focus:ring-4 focus:ring-secondary/20">
                        </label>
                    </div>
                    <div>
                        <span class="mb-2 block text-sm font-black text-slate-700">Salaire (FCFA/mois)</span>
                        <div class="flex items-center gap-4">
                            <input type="number" name="salaryMin" class="min-w-0 flex-1 rounded-2xl border border-slate-200 px-4 py-3 font-semibold outline-none focus:ring-4 focus:ring-secondary/20" placeholder="Min">
                            <span class="font-black text-slate-400">a</span>
                            <input type="number" name="salaryMax" class="min-w-0 flex-1 rounded-2xl border border-slate-200 px-4 py-3 font-semibold outline-none focus:ring-4 focus:ring-secondary/20" placeholder="Max">
                        </div>
                    </div>
                </div>
            </section>

            <section class="fade-in rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-100">
                <h2 class="mb-6 text-xl font-black text-slate-950">Profil recherche</h2>
                <div class="space-y-6">
                    <div>
                        <label class="block">
                            <span class="mb-2 block text-sm font-black text-slate-700">Niveau d'etudes minimum *</span>
                            <select name="requiredEducation" class="w-full rounded-2xl border border-slate-200 px-4 py-3 font-semibold outline-none focus:ring-4 focus:ring-secondary/20">
                                {% for level in educations %}<option value="{{ level }}" {% if level == 'Licence' %}selected{% endif %}>{{ level }}</option>{% endfor %}
                            </select>
                        </label>
                    </div>
                    <div>
                        <label class="block">
                            <span class="mb-2 block text-sm font-black text-slate-700">Annees d'experience minimum</span>
                            <input type="number" min="0" name="requiredExperienceYears" value="0" class="w-full rounded-2xl border border-slate-200 px-4 py-3 font-semibold outline-none focus:ring-4 focus:ring-secondary/20">
                        </label>
                    </div>
                    <div data-documents-builder>
                        <span class="mb-2 block text-sm font-black text-slate-700">Documents requis</span>
                        <p class="mb-3 text-sm font-semibold text-slate-500">Definissez les pieces a fournir par les candidats pour postuler a cette offre.</p>
                        <div class="space-y-2" data-documents-list>
                            <div class="flex items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3" data-document-row>
                                <input type="hidden" name="requiredDocuments[]" value="CV">
                                <span class="font-black text-slate-700">CV</span>
                                <button type="button" class="rounded-full bg-primary/10 px-3 py-1 text-xs font-black text-primary transition hover:bg-primary/15" data-document-toggle>Obligatoire</button>
                            </div>
                            <div class="flex items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3" data-document-row>
                                <input type="hidden" name="requiredDocuments[]" value="Lettre de motivation">
                                <span class="font-black text-slate-700">Lettre de motivation</span>
                                <button type="button" class="rounded-full bg-primary/10 px-3 py-1 text-xs font-black text-primary transition hover:bg-primary/15" data-document-toggle>Obligatoire</button>
                            </div>
                        </div>
                        <div class="mt-3 flex flex-col gap-2 sm:flex-row">
                            <select class="min-w-0 flex-1 rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-black text-slate-700 outline-none focus:ring-4 focus:ring-secondary/20" data-document-select>
                                <option value="Diplome">Diplome</option>
                                <option value="Certificat">Certificat</option>
                                <option value="Attestation">Attestation</option>
                                <option value="Permis de conduire">Permis de conduire</option>
                                <option value="Piece d'identite">Piece d'identite</option>
                                <option value="Portfolio">Portfolio</option>
                            </select>
                            <button type="button" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-secondary/10 px-4 py-3 text-sm font-black text-primary transition hover:bg-secondary/15" data-add-document>+ Ajouter un document</button>
                        </div>
                    </div>
                    <div>
                        <span class="mb-2 block text-sm font-black text-slate-700">Competences requises *</span>
                        <div class="mb-3 flex flex-wrap gap-2">
                            {% for skill in ['JavaScript','React','Node.js'] %}<span class="rounded-full bg-secondary/15 px-3 py-1.5 text-sm font-black text-primary">{{ skill }} <button type="button">x</button></span>{% endfor %}
                        </div>
                        <div class="flex gap-2">
                            <input name="requiredSkills" class="min-w-0 flex-1 rounded-2xl border border-slate-200 px-4 py-3 font-semibold outline-none focus:ring-4 focus:ring-secondary/20" placeholder="Ex: JavaScript, React, Symfony">
                        </div>
                        <div class="mt-3 flex flex-wrap gap-2">
                            {% for skill in skills %}<button type="button" class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600 hover:bg-secondary/10 hover:text-secondary">+ {{ skill }}</button>{% endfor %}
                        </div>
                    </div>
                </div>
            </section>

            <section class="fade-in rounded-3xl bg-gradient-to-r from-secondary/10 to-accent/20 p-6">
                <h3 class="mb-4 font-black text-slate-950">Apercu de votre offre</h3>
                <div class="rounded-2xl bg-white p-4">
                    <p class="text-lg font-black">Developpeur Web Full Stack</p>
                    <p class="mt-1 text-sm font-semibold text-slate-500">CDI · Ouagadougou</p>
                    <p class="mt-2 text-sm leading-6 text-slate-500">Votre offre apparaitra dans le feed candidat avec le score de matching et les documents requis.</p>
                </div>
            </section>

            <div class="flex justify-end">
                <button type="submit" class="rounded-2xl bg-gradient-to-r from-secondary to-primary px-8 py-3 font-black text-white shadow-lg shadow-secondary/20">Publier l'offre</button>
            </div>
        </form>
    </main>
</div>
{% endblock %}
