{% extends 'base.html.twig' %}

{% block title %}Offres d'emploi - KIBARE-JOB{% endblock %}

{% block body %}
<main class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-stone-50 text-slate-900 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900 dark:text-slate-100">
    <header class="border-b border-slate-200/80 bg-white/85 px-4 py-5 backdrop-blur dark:border-slate-800 dark:bg-slate-950/85 md:px-8">
        <div class="mx-auto flex max-w-7xl items-center justify-between">
            <a href="{{ path('home') }}" class="flex items-center gap-3">
                <span class="grid h-10 w-10 place-items-center rounded-2xl bg-gradient-to-br from-secondary to-primary text-white shadow-lg shadow-secondary/20">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M10 6h4a2 2 0 0 1 2 2v1h3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3V8a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                </span>
                <span class="text-xl font-black text-primary dark:text-white">KIBARE-JOB</span>
            </a>
            <nav class="hidden items-center gap-6 text-sm font-bold text-slate-600 dark:text-slate-300 md:flex">
                <a href="{{ path('home') }}" class="transition hover:text-secondary">Accueil</a>
                <a href="{{ path('public_jobs') }}" class="text-secondary">Offres d'emploi</a>
                <a href="{{ path('candidate_landing') }}" class="transition hover:text-secondary">Candidats</a>
                <a href="{{ path('faq') }}" class="transition hover:text-secondary">FAQ</a>
                <a href="{{ path('contact') }}" class="transition hover:text-secondary">Contact</a>
                <a href="{{ path('recruiter_entry') }}" class="rounded-full bg-primary px-5 py-2.5 text-white shadow-sm transition hover:bg-secondary">Espace recruteur</a>
            </nav>
        </div>
    </header>

    <section class="px-4 py-12 md:px-8 md:py-16">
        <div class="mx-auto max-w-7xl">
            <div class="mb-8 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
                <div class="max-w-3xl">
                    <p class="mb-4 inline-flex rounded-full border border-secondary/20 bg-white px-4 py-2 text-sm font-black text-secondary shadow-sm dark:border-secondary/30 dark:bg-slate-900">Offres disponibles</p>
                    <h1 class="text-4xl font-black tracking-tight text-slate-950 dark:text-white md:text-5xl">Explorez les offres d'emploi ouvertes.</h1>
                    <p class="mt-5 max-w-2xl leading-8 text-slate-600 dark:text-slate-300">Cette page est dynamique : les offres, les pays, les localités et les secteurs proposés dans les filtres viennent directement des offres disponibles en base.</p>
                </div>
                <div class="rounded-3xl border border-slate-200 bg-white p-5 text-center shadow-sm dark:border-slate-800 dark:bg-slate-900">
                    <strong class="block text-3xl font-black text-slate-950 dark:text-white">{{ offers|length }}</strong>
                    <span class="text-sm font-bold text-slate-500 dark:text-slate-400">offre{{ offers|length > 1 ? 's' : '' }} trouvée{{ offers|length > 1 ? 's' : '' }}</span>
                </div>
            </div>

            <form method="get" action="{{ path('public_jobs') }}" class="mb-8 rounded-3xl border border-slate-200 bg-white p-4 shadow-soft dark:border-slate-800 dark:bg-slate-900 md:p-5">
                <div class="grid gap-3 lg:grid-cols-4">
                    <label class="lg:col-span-2">
                        <span class="mb-2 block text-xs font-black uppercase tracking-wide text-slate-500 dark:text-slate-400">Recherche</span>
                        <input type="search" name="q" value="{{ filters.q }}" placeholder="Métier, compétence, entreprise..." class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold text-slate-700 outline-none transition focus:border-secondary focus:ring-4 focus:ring-secondary/15 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
                    </label>

                    <label>
                        <span class="mb-2 block text-xs font-black uppercase tracking-wide text-slate-500 dark:text-slate-400">Pays</span>
                        <select name="country" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold text-slate-700 outline-none transition focus:border-secondary focus:ring-4 focus:ring-secondary/15 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
                            <option value="">Tous les pays</option>
                            {% for country in filterOptions.countries %}
                                <option value="{{ country }}" {{ filters.country == country ? 'selected' : '' }}>{{ country }}</option>
                            {% endfor %}
                        </select>
                    </label>

                    <label>
                        <span class="mb-2 block text-xs font-black uppercase tracking-wide text-slate-500 dark:text-slate-400">Ville ou localité</span>
                        <input list="job-locations" type="search" name="location" value="{{ filters.location }}" placeholder="Ouagadougou, Bobo..." class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold text-slate-700 outline-none transition focus:border-secondary focus:ring-4 focus:ring-secondary/15 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
                        <datalist id="job-locations">
                            {% for location in filterOptions.locations %}
                                <option value="{{ location }}"></option>
                            {% endfor %}
                        </datalist>
                    </label>

                    <label>
                        <span class="mb-2 block text-xs font-black uppercase tracking-wide text-slate-500 dark:text-slate-400">Secteur d'activité</span>
                        <select name="sector" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold text-slate-700 outline-none transition focus:border-secondary focus:ring-4 focus:ring-secondary/15 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
                            <option value="">Tous les secteurs</option>
                            {% for sector in filterOptions.sectors %}
                                <option value="{{ sector }}" {{ filters.sector == sector ? 'selected' : '' }}>{{ sector }}</option>
                            {% endfor %}
                        </select>
                    </label>

                    <label>
                        <span class="mb-2 block text-xs font-black uppercase tracking-wide text-slate-500 dark:text-slate-400">Contrat</span>
                        <select name="contractType" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold text-slate-700 outline-none transition focus:border-secondary focus:ring-4 focus:ring-secondary/15 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
                            <option value="">Tous les contrats</option>
                            {% for contract in contractTypes %}
                                <option value="{{ contract.value }}" {{ filters.contractType == contract.value ? 'selected' : '' }}>{{ contract.value }}</option>
                            {% endfor %}
                        </select>
                    </label>

                    <label>
                        <span class="mb-2 block text-xs font-black uppercase tracking-wide text-slate-500 dark:text-slate-400">Mode de travail</span>
                        <select name="remote" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold text-slate-700 outline-none transition focus:border-secondary focus:ring-4 focus:ring-secondary/15 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
                            <option value="">Tous</option>
                            <option value="yes" {{ filters.remote == 'yes' ? 'selected' : '' }}>Télétravail possible</option>
                        </select>
                    </label>

                    <label>
                        <span class="mb-2 block text-xs font-black uppercase tracking-wide text-slate-500 dark:text-slate-400">Source</span>
                        <select name="source" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold text-slate-700 outline-none transition focus:border-secondary focus:ring-4 focus:ring-secondary/15 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
                            <option value="">Toutes les sources</option>
                            <option value="internal" {{ filters.source == 'internal' ? 'selected' : '' }}>KIBARE-JOB</option>
                            <option value="external" {{ filters.source == 'external' ? 'selected' : '' }}>Sources externes</option>
                        </select>
                    </label>

                    <label>
                        <span class="mb-2 block text-xs font-black uppercase tracking-wide text-slate-500 dark:text-slate-400">Tri</span>
                        <select name="sort" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold text-slate-700 outline-none transition focus:border-secondary focus:ring-4 focus:ring-secondary/15 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
                            <option value="recent" {{ filters.sort == 'recent' ? 'selected' : '' }}>Plus récentes</option>
                            <option value="popular" {{ filters.sort == 'popular' ? 'selected' : '' }}>Plus consultées</option>
                            <option value="applications" {{ filters.sort == 'applications' ? 'selected' : '' }}>Plus de postulations</option>
                            <option value="liked" {{ filters.sort == 'liked' ? 'selected' : '' }}>Plus aimées</option>
                            <option value="deadline" {{ filters.sort == 'deadline' ? 'selected' : '' }}>Expiration proche</option>
                        </select>
                    </label>
                </div>

                <div class="mt-4 flex flex-col gap-3 border-t border-slate-100 pt-4 dark:border-slate-800 sm:flex-row sm:items-center sm:justify-between">
                    <p class="text-sm font-bold text-slate-500 dark:text-slate-400">
                        {{ activeFiltersCount }} filtre{{ activeFiltersCount > 1 ? 's' : '' }} actif{{ activeFiltersCount > 1 ? 's' : '' }}
                    </p>
                    <div class="flex flex-col gap-3 sm:flex-row">
                        {% if activeFiltersCount > 0 %}
                            <a href="{{ path('public_jobs') }}" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-6 py-3 font-black text-slate-700 shadow-sm transition hover:border-secondary/30 hover:text-secondary dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">Réinitialiser</a>
                        {% endif %}
                        <button class="inline-flex items-center justify-center rounded-2xl bg-primary px-6 py-3 font-black text-white shadow-sm transition hover:bg-secondary">Appliquer les filtres</button>
                    </div>
                </div>
            </form>

            {% if offers is empty %}
                <div class="rounded-3xl border border-slate-200 bg-white p-10 text-center shadow-soft dark:border-slate-800 dark:bg-slate-900">
                    <h2 class="text-2xl font-black text-slate-950 dark:text-white">Aucune offre trouvée</h2>
                    <p class="mx-auto mt-3 max-w-xl leading-7 text-slate-600 dark:text-slate-300">Essayez avec un autre métier, une autre ville, un autre pays ou un autre secteur d'activité.</p>
                </div>
            {% else %}
                <div class="grid gap-5 lg:grid-cols-2">
                    {% for offer in offers %}
                        {% set company = offer.externalSourceName ?: (offer.employer.employer ? offer.employer.employer.companyName : offer.employer.displayName) %}
                        {% set sector = offer.employer.employer ? offer.employer.employer.sector : null %}
                        {% set country = offer.employer.employer ? offer.employer.employer.countryName : null %}
                        {% set isLiked = (offer.id ~ '') in likedOfferIds %}
                        <article class="group rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-secondary/30 hover:shadow-xl dark:border-slate-800 dark:bg-slate-900" data-like-scope>
                                <div class="mb-5 flex items-start justify-between gap-4">
                                    <div>
                                        <p class="text-sm font-black uppercase tracking-wide text-secondary">{{ company }}</p>
                                        <a href="{{ path('public_job_detail', {id: offer.id}) }}" class="block">
                                            <h2 class="mt-2 text-2xl font-black leading-snug text-slate-950 transition group-hover:text-primary dark:text-white">{{ offer.title }}</h2>
                                        </a>
                                    </div>
                                    <form method="post" action="{{ path('public_job_like', {id: offer.id}) }}" data-like-form>
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('like_offer_' ~ offer.id) }}">
                                        <button type="submit" title="{{ isLiked ? 'Retirer le like' : 'Aimer cette offre' }}" aria-label="{{ isLiked ? 'Retirer le like' : 'Aimer cette offre' }}" data-like-button data-liked="{{ isLiked ? 'true' : 'false' }}" class="grid h-11 w-11 place-items-center rounded-full border transition {{ isLiked ? 'border-secondary/30 bg-secondary/10 text-secondary' : 'border-slate-200 bg-slate-50 text-slate-500 hover:border-secondary/30 hover:text-secondary dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300' }}">
                                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="{{ isLiked ? 'currentColor' : 'none' }}" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-like-icon>
                                                <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/>
                                            </svg>
                                        </button>
                                    </form>
                                </div>

                                <a href="{{ path('public_job_detail', {id: offer.id}) }}" class="block">
                                    {% set cleanDescription = offer.description|job_description_text %}
                                    <p class="line-clamp-3 leading-7 text-slate-600 dark:text-slate-300">{{ cleanDescription|slice(0, 220) }}{% if cleanDescription|length > 220 %}...{% endif %}</p>
                                </a>

                                <div class="mt-5 flex flex-wrap gap-2">
                                    <span class="rounded-full bg-slate-100 px-3 py-1 text-sm font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-200">{{ offer.location }}</span>
                                    {% if country %}
                                        <span class="rounded-full bg-slate-100 px-3 py-1 text-sm font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-200">{{ country }}</span>
                                    {% endif %}
                                    {% if sector %}
                                        <span class="rounded-full bg-slate-100 px-3 py-1 text-sm font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-200">{{ sector }}</span>
                                    {% endif %}
                                    <span class="rounded-full bg-slate-100 px-3 py-1 text-sm font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-200">{{ offer.contractType.value }}</span>
                                    {% if offer.isRemoteAllowed %}
                                        <span class="rounded-full bg-secondary/10 px-3 py-1 text-sm font-bold text-secondary">Télétravail</span>
                                    {% endif %}
                                </div>

                                <div class="mt-6 grid grid-cols-3 gap-3 border-t border-slate-100 pt-5 text-center dark:border-slate-800">
                                    <div><strong class="block text-lg text-slate-950 dark:text-white">{{ offer.viewsCount }}</strong><span class="text-xs font-bold text-slate-500">consultations</span></div>
                                    <div><strong class="block text-lg text-slate-950 dark:text-white">{{ offer.applicationsCount }}</strong><span class="text-xs font-bold text-slate-500">postulations</span></div>
                                    <div><strong class="block text-lg text-slate-950 dark:text-white" data-like-count>{{ offer.likesCount }}</strong><span class="text-xs font-bold text-slate-500">likes</span></div>
                                </div>
                                <p class="mt-3 min-h-5 text-center text-sm font-bold text-slate-500 dark:text-slate-400" data-like-feedback aria-live="polite"></p>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </section>
</main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('[data-like-form]').forEach(function (form) {
                var scope = form.closest('[data-like-scope]') || document;
                var button = form.querySelector('[data-like-button]');
                var icon = form.querySelector('[data-like-icon]');
                var count = scope.querySelector('[data-like-count]');
                var feedback = scope.querySelector('[data-like-feedback]');
                var likedClasses = ['border-secondary/30', 'bg-secondary/10', 'text-secondary'];
                var unlikedClasses = ['border-slate-200', 'bg-slate-50', 'text-slate-500', 'hover:border-secondary/30', 'hover:text-secondary', 'dark:border-slate-700', 'dark:bg-slate-950', 'dark:text-slate-300'];

                function setButtonState(isLiked) {
                    button.dataset.liked = isLiked ? 'true' : 'false';
                    button.setAttribute('title', isLiked ? 'Retirer le like' : 'Aimer cette offre');
                    button.setAttribute('aria-label', isLiked ? 'Retirer le like' : 'Aimer cette offre');
                    if (icon) {
                        icon.setAttribute('fill', isLiked ? 'currentColor' : 'none');
                    }
                    button.classList.remove.apply(button.classList, isLiked ? unlikedClasses : likedClasses);
                    button.classList.add.apply(button.classList, isLiked ? likedClasses : unlikedClasses);
                }

                form.addEventListener('submit', function (event) {
                    event.preventDefault();
                    event.stopPropagation();

                    if (button.disabled) {
                        return;
                    }

                    button.disabled = true;
                    button.classList.add('opacity-70', 'cursor-wait');
                    if (feedback) {
                        feedback.textContent = '';
                    }

                    fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: {
                            'Accept': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                        .then(function (response) {
                            return response.json().then(function (payload) {
                                if (!response.ok || !payload.success) {
                                    throw new Error(payload.message || 'Action impossible pour le moment.');
                                }

                                return payload;
                            });
                        })
                        .then(function (payload) {
                            setButtonState(Boolean(payload.liked));
                            if (count) {
                                count.textContent = payload.likesCount;
                            }
                            if (feedback) {
                                feedback.textContent = payload.message;
                            }
                        })
                        .catch(function (error) {
                            if (feedback) {
                                feedback.textContent = error.message;
                            }
                        })
                        .finally(function () {
                            button.disabled = false;
                            button.classList.remove('opacity-70', 'cursor-wait');
                        });
                });
            });
        });
    </script>
{% endblock %}
