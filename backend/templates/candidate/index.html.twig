{% extends 'base.html.twig' %}

{% block title %}Candidats - KIBARE-JOB{% endblock %}

{% block body %}
<main class="min-h-screen bg-slate-50">
    <section class="bg-primary px-5 py-8 text-white">
        <nav class="mx-auto flex max-w-7xl items-center justify-between">
            <a href="{{ path('home') }}" class="font-black">KIBARE-JOB</a>
            <a href="{{ path('app_login') }}" class="rounded-full bg-white px-5 py-2 text-sm font-black text-primary transition duration-300 hover:scale-105">Connexion</a>
        </nav>
        <div class="fade-in mx-auto grid max-w-7xl gap-12 py-20 lg:grid-cols-[.9fr_1.1fr]">
            <div>
                <p class="font-black uppercase tracking-[0.2em] text-accent">Application candidat</p>
                <h1 class="mt-4 text-5xl font-black leading-tight sm:text-6xl">Swipe les offres. Postule en un geste.</h1>
                <p class="mt-6 max-w-xl text-lg leading-8 text-white/75">Une experience inspiree du mobile: cartes rapides, documents toujours prets, candidature automatique et suivi clair.</p>
                <div class="mt-9 flex flex-col gap-4 sm:flex-row">
                    <a href="#" class="rounded-2xl bg-accent px-7 py-4 text-center font-black text-primary transition duration-300 hover:scale-105">Android</a>
                    <a href="#" class="rounded-2xl border border-white/20 px-7 py-4 text-center font-black text-white transition duration-300 hover:scale-105">iOS</a>
                </div>
            </div>
            <div class="flex gap-5 overflow-x-auto pb-6">
                {% for item in [
                    {title: 'Feed', score: '88%', color: 'bg-accent'},
                    {title: 'Documents', score: '12', color: 'bg-secondary'},
                    {title: 'Matching', score: '94%', color: 'bg-accent'}
                ] %}
                    <article class="min-w-[260px] rounded-[2rem] bg-slate-950 p-4 shadow-soft">
                        <div class="rounded-[1.5rem] bg-white p-5 text-primary">
                            <div class="h-56 rounded-2xl {{ item.color }} p-5 text-white">
                                <p class="text-sm font-bold">{{ item.title }}</p>
                                <p class="mt-20 text-5xl font-black">{{ item.score }}</p>
                            </div>
                            <div class="mt-5 h-3 rounded-full bg-slate-100"></div>
                            <div class="mt-3 h-3 w-2/3 rounded-full bg-slate-100"></div>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-20">
        <div class="grid gap-6 md:grid-cols-3">
            {% for guide in [
                {title: 'Swipe gauche/droite', text: 'Refuse ou aime une offre selon ton interet et ton niveau de compatibilite.'},
                {title: 'Matching automatique', text: 'Le score t’aide a comprendre pourquoi une offre correspond a ton profil.'},
                {title: 'Candidature en 1 clic', text: 'Le CV, la lettre et les documents utiles sont prepares automatiquement.'}
            ] %}
                <article class="fade-in rounded-2xl bg-white p-7 shadow-soft transition duration-300 hover:scale-[1.02]">
                    <h2 class="text-2xl font-black text-primary">{{ guide.title }}</h2>
                    <p class="mt-4 leading-7 text-slate-600">{{ guide.text }}</p>
                </article>
            {% endfor %}
        </div>
    </section>
</main>
{% endblock %}
