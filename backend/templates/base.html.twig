<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}KIBARE-JOB{% endblock %}</title>
        <meta name="description" content="KIBARE-JOB, le recrutement intelligent pour l'Afrique.">
        <script>
            (function () {
                var savedTheme = localStorage.getItem('kibarejob-theme');
                var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
                    document.documentElement.classList.add('dark');
                }
            })();
        </script>
        <link rel="icon" type="image/png" href="{{ asset('assets/brand/kibare-job-icon.png') }}">
        <link rel="stylesheet" href="{{ asset('assets/kibarejob.css') }}?v=2026050901">
        <link rel="stylesheet" href="{{ asset('assets/error-pages.css') }}?v=2026050901">
        {% block stylesheets %}{% endblock %}
    </head>
    <body class="bg-slate-50 text-slate-900 antialiased">
        {% block body %}{% endblock %}
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Changer de theme" aria-pressed="false">
            <span class="theme-toggle__track">
                <span class="theme-toggle__thumb" aria-hidden="true"></span>
            </span>
            <span class="theme-toggle__label" data-theme-label>Light</span>
        </button>
        <script src="{{ asset('assets/kibarejob.js') }}?v=2026050815" defer></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
