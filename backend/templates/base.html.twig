<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}KIBARE-JOB{% endblock %}</title>
        <meta name="description" content="KIBARE-JOB, le recrutement intelligent pour l'Afrique.">
        <script>
            (function () {
                var savedTheme = localStorage.getItem('kibarejob-theme');
                var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
                    document.documentElement.classList.add('dark');
                }
            })();
        </script>
        <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'%3E%3Crect width='128' height='128' rx='28' fill='%23263849'/%3E%3Ctext x='25' y='82' font-size='48' fill='%23B8C7B4' font-family='Arial'%3EKJ%3C/text%3E%3C/svg%3E">
        <link rel="stylesheet" href="{{ asset('assets/kibarejob.css') }}?v=2026050807">
        {% block stylesheets %}{% endblock %}
    </head>
    <body class="bg-slate-50 text-slate-900 antialiased">
        {% block body %}{% endblock %}
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Changer de theme" aria-pressed="false">
            <span class="theme-toggle__track">
                <span class="theme-toggle__thumb" aria-hidden="true"></span>
            </span>
            <span class="theme-toggle__label" data-theme-label>Light</span>
        </button>
        <script src="{{ asset('assets/kibarejob.js') }}?v=2026050810" defer></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
