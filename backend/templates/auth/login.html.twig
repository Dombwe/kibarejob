{% extends 'base.html.twig' %}

{% block title %}Connexion - KIBARE-JOB{% endblock %}

{% block body %}
<main class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-stone-50 px-5 py-8">
    {% set toastMessages = [] %}
    {% for message in app.flashes('success') %}
        {% set toastMessages = toastMessages|merge([{type: 'success', text: message}]) %}
    {% endfor %}
    {% for message in app.flashes('info') %}
        {% set toastMessages = toastMessages|merge([{type: 'info', text: message}]) %}
    {% endfor %}
    {% if toastMessages is not empty %}
        <div class="fixed right-5 top-5 z-50 w-[min(24rem,calc(100vw-2.5rem))] space-y-3" data-toast-stack>
            {% for toast in toastMessages %}
                <div class="rounded-2xl border px-5 py-4 text-sm font-bold text-white shadow-soft transition duration-500 {% if toast.type == 'success' %}border-accent/50 bg-primary{% else %}border-secondary/40 bg-secondary{% endif %}" data-toast style="opacity:1; transform:translateX(0);">
                    {{ toast.text }}
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <div class="mx-auto flex min-h-[calc(100vh-4rem)] max-w-6xl items-center">
        <section class="grid w-full overflow-hidden rounded-[2rem] bg-white shadow-soft ring-1 ring-slate-100 lg:grid-cols-[0.95fr_1.05fr]">
            <aside class="relative hidden bg-gradient-to-br from-primary via-slate-700 to-secondary p-10 text-white lg:block">
                <a href="{{ path('home') }}" class="inline-flex items-center gap-3 font-black">
                    <img src="{{ asset('assets/brand/kibare-job-logo.jpg') }}" alt="KIBARE-JOB" class="h-14 w-auto rounded-2xl shadow-lg shadow-black/20">
                </a>
                <div class="mt-24">
                    <p class="mb-4 inline-flex rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-bold text-white/85">Espace recruteur</p>
                    <h1 class="max-w-sm text-4xl font-black leading-tight">Connectez-vous à votre tableau de bord premium.</h1>
                    <p class="mt-5 max-w-md leading-7 text-white/75">Publiez vos offres, suivez les candidatures et analysez vos recrutements dans une interface claire et professionnelle.</p>
                </div>
                <div class="absolute bottom-10 left-10 right-10 grid grid-cols-3 gap-3">
                    {% for item in [{value:'112', label:'Candidatures'}, {value:'12', label:'Entretiens'}, {value:'95%', label:'Matching'}] %}
                        <div class="rounded-2xl border border-white/15 bg-white/10 p-4 backdrop-blur">
                            <div class="text-2xl font-black">{{ item.value }}</div>
                            <div class="text-xs font-bold text-white/65">{{ item.label }}</div>
                        </div>
                    {% endfor %}
                </div>
            </aside>

            <div class="p-6 sm:p-10">
                <div class="mb-8 flex items-center justify-between">
                    <a href="{{ path('home') }}" class="inline-flex items-center gap-3 font-black text-primary lg:hidden">
                        <img src="{{ asset('assets/brand/kibare-job-logo.jpg') }}" alt="KIBARE-JOB" class="h-12 w-auto rounded-2xl shadow-lg shadow-secondary/20">
                    </a>
                    <a href="{{ path('app_register') }}" class="ml-auto rounded-full border border-slate-200 px-4 py-2 text-sm font-black text-slate-600 transition hover:border-secondary/30 hover:text-secondary">Créer un compte</a>
                </div>

                <div class="mx-auto max-w-md">
                    <p class="mb-4 inline-flex rounded-full bg-secondary/10 px-4 py-2 text-sm font-black text-secondary">Connexion securisee</p>
                    <h2 class="text-3xl font-black text-primary">Connexion recruteur</h2>
                    <p class="mt-3 leading-7 text-slate-600">Connectez-vous pour publier des offres et suivre vos candidatures.</p>

                    {% for message in app.flashes('error') %}
                        <div class="mt-5 rounded-2xl bg-slate-100 px-4 py-3 text-sm font-semibold text-slate-700">{{ message }}</div>
                    {% endfor %}
                    {% if error %}
                        <div class="mt-5 rounded-2xl bg-slate-100 px-4 py-3 text-sm font-semibold text-slate-700">
                            Email ou mot de passe incorrect. Vérifiez vos informations puis réessayez.
                        </div>
                    {% endif %}

                    <form class="mt-8 space-y-5" method="post" data-login-form>
                        <label class="block">
                            <span class="text-sm font-black text-slate-700">Email</span>
                            <input class="mt-2 w-full rounded-2xl border border-slate-200 px-4 py-3 outline-none transition focus:border-secondary focus:ring-4 focus:ring-secondary/20" type="email" name="email" value="{{ last_username }}" autocomplete="email" required>
                        </label>
                        <label class="block">
                            <span class="text-sm font-black text-slate-700">Mot de passe</span>
                            <span class="relative mt-2 block">
                                <input class="w-full rounded-2xl border border-slate-200 px-4 py-3 pr-20 outline-none transition focus:border-secondary focus:ring-4 focus:ring-secondary/20" type="password" name="password" autocomplete="current-password" required data-password-input>
                                <button class="absolute inset-y-0 right-3 my-auto rounded-full px-3 text-xs font-black text-slate-500 transition hover:bg-slate-100 hover:text-primary" type="button" aria-label="Afficher le mot de passe" data-password-toggle>
                                    <span data-password-icon>Voir</span>
                                </button>
                            </span>
                        </label>
                        <div class="flex justify-end">
                            <a href="{{ path('app_forgot_password') }}" class="text-sm font-black text-secondary transition hover:text-primary">Mot de passe oublié ?</a>
                        </div>
                        <button class="flex w-full items-center justify-center rounded-2xl bg-primary px-6 py-4 font-black text-white transition duration-300 hover:scale-[1.02] hover:bg-secondary" type="submit">
                            <span data-login-label>Se connecter</span>
                            <span class="hidden" data-login-loader>Connexion...</span>
                        </button>
                    </form>

                    <p class="mt-7 text-center text-sm font-semibold text-slate-600">
                        Pas encore de compte ?
                        <a href="{{ path('app_register') }}" class="font-black text-secondary transition hover:text-primary">Créer un compte recruteur</a>
                    </p>

                    <form class="mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-4" method="post" action="{{ path('app_resend_verification') }}">
                        <label class="block">
                            <span class="text-sm font-black text-slate-700">Renvoyer le mail de confirmation</span>
                            <input class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 outline-none transition focus:border-secondary focus:ring-4 focus:ring-secondary/20" type="email" name="email" value="{{ last_username }}" autocomplete="email" required>
                        </label>
                        <button class="mt-3 w-full rounded-2xl border border-secondary/30 px-5 py-3 text-sm font-black text-secondary transition hover:bg-secondary hover:text-white" type="submit">
                            Renvoyer le lien
                        </button>
                    </form>
                </div>
            </div>
        </section>
    </div>
</main>
{% endblock %}




