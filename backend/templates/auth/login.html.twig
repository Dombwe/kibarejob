{% extends 'base.html.twig' %}

{% block title %}Connexion - KIBARE-JOB{% endblock %}

{% block body %}
<main class="grid min-h-screen place-items-center bg-[linear-gradient(135deg,#0F172A_0%,#172554_48%,#0F172A_100%)] px-5 py-12">
    {% set toastMessages = [] %}
    {% for message in app.flashes('success') %}
        {% set toastMessages = toastMessages|merge([{type: 'success', text: message}]) %}
    {% endfor %}
    {% for message in app.flashes('info') %}
        {% set toastMessages = toastMessages|merge([{type: 'info', text: message}]) %}
    {% endfor %}
    {% if toastMessages is not empty %}
        <div class="fixed right-5 top-5 z-50 w-[min(24rem,calc(100vw-2.5rem))] space-y-3" data-toast-stack>
            {% for toast in toastMessages %}
                <div class="rounded-2xl border px-5 py-4 text-sm font-bold text-white shadow-soft transition duration-500 {% if toast.type == 'success' %}border-emerald-400/40 bg-emerald-600{% else %}border-sky-400/40 bg-sky-600{% endif %}" data-toast style="opacity:1; transform:translateX(0);">
                    {{ toast.text }}
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <section class="fade-in w-full max-w-md rounded-2xl bg-white p-8 shadow-soft">
        <a href="{{ path('home') }}" class="mb-8 inline-flex items-center gap-3 font-black text-primary">
            <span class="grid h-11 w-11 place-items-center rounded-2xl bg-primary text-accent">KJ</span>
            KIBARE-JOB
        </a>
        <h1 class="text-3xl font-black text-primary">Connexion recruteur</h1>
        <p class="mt-3 leading-7 text-slate-600">Connectez-vous pour publier des offres et suivre vos candidatures.</p>

        {% for message in app.flashes('error') %}
            <div class="mt-5 rounded-2xl bg-red-50 px-4 py-3 text-sm font-semibold text-white-700">{{ message }}</div>
        {% endfor %}
        {% if error %}
            <div class="mt-5 rounded-2xl bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">
                Email ou mot de passe incorrect. Verifiez vos informations puis reessayez.
            </div>
        {% endif %}

        <form class="mt-8 space-y-5" method="post" data-login-form>
            <label class="block">
                <span class="text-sm font-black text-slate-700">Email</span>
                <input class="mt-2 w-full rounded-2xl border border-slate-200 px-4 py-3 outline-none transition focus:border-secondary focus:ring-4 focus:ring-blue-100" type="email" name="email" value="{{ last_username }}" autocomplete="email" required>
            </label>
            <label class="block">
                <span class="text-sm font-black text-slate-700">Mot de passe</span>
                <span class="relative mt-2 block">
                    <input class="w-full rounded-2xl border border-slate-200 px-4 py-3 pr-14 outline-none transition focus:border-secondary focus:ring-4 focus:ring-blue-100" type="password" name="password" autocomplete="current-password" required data-password-input>
                    <button class="absolute inset-y-0 right-3 my-auto grid h-9 w-9 place-items-center rounded-full text-slate-500 transition hover:bg-slate-100 hover:text-primary" type="button" aria-label="Afficher le mot de passe" data-password-toggle>
                        <span data-password-icon>👁</span>
                    </button>
                </span>
            </label>
            <div class="flex justify-end">
                <a href="{{ path('app_forgot_password') }}" class="text-sm font-black text-secondary transition hover:text-primary">Mot de passe oublie ?</a>
            </div>
            <button class="flex w-full items-center justify-center rounded-2xl bg-accent px-6 py-4 font-black text-primary transition duration-300 hover:scale-[1.02]" type="submit">
                <span data-login-label>Se connecter</span>
                <span class="hidden" data-login-loader>Connexion...</span>
            </button>
        </form>

        {# <div class="my-6 flex items-center gap-3 text-xs font-black uppercase tracking-[0.18em] text-slate-400">
            <span class="h-px flex-1 bg-slate-200"></span>
            ou
            <span class="h-px flex-1 bg-slate-200"></span>
        </div>

        <a href="{{ path('connect_google_start') }}" class="flex w-full items-center justify-center rounded-2xl border border-slate-200 bg-white px-6 py-4 font-black text-primary transition duration-300 hover:scale-[1.02] hover:bg-slate-50">
            Continuer avec Google
        </a> #}

        <p class="mt-7 text-center text-sm font-semibold text-slate-600">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}" class="font-black text-secondary transition hover:text-primary">Creer un compte recruteur</a>
        </p>
    </section>
</main>
{% endblock %}
