{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublie - KIBARE-JOB{% endblock %}

{% block body %}
<main class="grid min-h-screen place-items-center bg-[linear-gradient(135deg,#0F172A_0%,#172554_48%,#0F172A_100%)] px-5 py-12">
    <section class="fade-in w-full max-w-md rounded-2xl bg-white p-8 shadow-soft">
        <a href="{{ path('home') }}" class="mb-8 inline-flex items-center gap-3 font-black text-primary">
            <span class="grid h-11 w-11 place-items-center rounded-2xl bg-primary text-accent">KJ</span>
            KIBARE-JOB
        </a>
        <h1 class="text-3xl font-black text-primary">Mot de passe oublie</h1>
        <p class="mt-3 leading-7 text-slate-600">Indique ton email. Si un compte existe, un lien de reinitialisation sera envoye.</p>

        <form class="mt-8 space-y-5" method="post">
            <label class="block">
                <span class="text-sm font-black text-slate-700">Email</span>
                <input class="mt-2 w-full rounded-2xl border border-slate-200 px-4 py-3 outline-none transition focus:border-secondary focus:ring-4 focus:ring-blue-100" type="email" name="email" value="{{ email }}" autocomplete="email" required>
                {% for error in errors.email ?? [] %}
                    <span class="mt-2 block text-sm font-semibold text-red-600">{{ error }}</span>
                {% endfor %}
            </label>

            <button class="flex w-full items-center justify-center rounded-2xl bg-accent px-6 py-4 font-black text-primary transition duration-300 hover:scale-[1.02]" type="submit">
                Envoyer le lien
            </button>
        </form>

        <p class="mt-7 text-center text-sm font-semibold text-slate-600">
            <a href="{{ path('app_login') }}" class="font-black text-secondary transition hover:text-primary">Retour a la connexion</a>
        </p>
    </section>
</main>
{% endblock %}
