### KIBARE-JOB production example
### Copy to .env.local or configure the same values in your host secrets manager.

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change_me_with_a_64_chars_random_secret
APP_PUBLIC_URL=https://kibarejob.com
CORS_ALLOW_ORIGIN='^https?://(kibarejob\.com|www\.kibarejob\.com)$'

### Database
### MySQL example:
DATABASE_URL="mysql://kibarejob_user:change_me@127.0.0.1:3306/kibarejob_prod?serverVersion=8.0&charset=utf8mb4"
### PostgreSQL example:
# DATABASE_URL="postgresql://kibarejob_user:change_me@127.0.0.1:5432/kibarejob_prod?serverVersion=16&charset=utf8"

### Cache / queues / locks
REDIS_URL=redis://127.0.0.1:6379
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
LOCK_DSN=redis://127.0.0.1:6379

### JWT
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me
JWT_TOKEN_TTL=3600

### Email
MAIL_FROM=no-reply@kibarejob.com
CONTACT_TO=contact@kibarejob.com
MAILER_DSN=smtp://smtp_user:smtp_password@smtp.example.com:587?encryption=tls

### Google OAuth mobile/web
GOOGLE_CLIENT_ID=change_me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change_me

### External job imports
RAPIDAPI_KEY=change_me
EXTERNAL_JOB_IMPORT_LIMIT=50

### File storage
### Current app writes local files under var/storage unless you provide an absolute path.
### In production this directory must be persisted, writable by PHP, and backed up.
KIBARE_STORAGE_PATH=var/storage
KIBARE_STORAGE_BASE_URL=/storage
