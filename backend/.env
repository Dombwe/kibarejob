APP_ENV=dev
APP_SECRET=change-me-kibarejob-dev-secret
DATABASE_URL="mysql://root:@127.0.0.1:3306/kibarejob?serverVersion=8.0&charset=utf8mb4"

### KIBARE-JOB subscriptions/payment mock mode
SUBSCRIPTION_MODE=mock
PAYMENT_METHOD=none

### Redis cache, sessions and rate limiting
REDIS_URL=redis://127.0.0.1:6379
REDIS_CACHE_TTL=120

### Messenger async jobs
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

### JWT keys generated later with lexik:jwt:generate-keypair
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=

### Later production integrations
# ORANGE_MONEY_API_URL=
# ORANGE_MONEY_CLIENT_ID=

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=ee67c234a4bab63934cf6ec66dad4484
