### KIBARE-JOB subscriptions/payment mock mode
SUBSCRIPTION_MODE=mock
PAYMENT_METHOD=none

### Redis cache, sessions and rate limiting
REDIS_URL=redis://127.0.0.1:6379
REDIS_CACHE_TTL=120

### Messenger async jobs
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

